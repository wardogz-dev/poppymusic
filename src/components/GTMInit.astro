---
// Composant d'initialisation du tracking GTM pour les pages de formulaire
export interface Props {
    pageType?: string;
    formName?: string;
}

const { pageType = 'form', formName = 'brief_creation' } = Astro.props;
---

<script define:vars={{ pageType, formName }}>
    // Import du tracker GTM
    import { initGTMTracking, getGTMTracker } from './GTMTracker.js';

    // Initialisation du tracking
    document.addEventListener('DOMContentLoaded', () => {
        initGTMTracking();

        // Configuration spécifique selon le type de page
        const tracker = getGTMTracker();

        // Tracking de la page vue
        tracker.trackEvent('page_view', {
            page_type: pageType,
            form_name: formName,
            page_url: window.location.href,
            page_title: document.title
        });

        // Pour les pages de formulaire, on ajoute des listeners supplémentaires
        if (pageType === 'form') {
            // Tracking des focus sur champs de formulaire
            document.addEventListener('focusin', (e) => {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT') {
                    tracker.trackUserInteraction('field_focus', e.target.name || e.target.id, {
                        field_type: e.target.type || e.target.tagName.toLowerCase(),
                        form_name: formName
                    });
                }
            });

            // Tracking des erreurs de validation
            document.addEventListener('invalid', (e) => {
                tracker.trackError('form_validation', 'Champ requis non rempli', {
                    field_name: e.target.name || e.target.id,
                    field_type: e.target.type,
                    form_name: formName
                });
                e.preventDefault();
            }, true);
        }
    });

    // Exposition globale pour le JavaScript du formulaire
    window.GTMTracker = getGTMTracker();
</script>
