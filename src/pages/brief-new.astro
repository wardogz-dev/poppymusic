		<script>
			// @ts-nocheck
			// Vérification côté client pour éviter les erreurs de build
			if (typeof window !== 'undefined') {
				// Initialiser dataLayer pour GTM
				window.dataLayer = window.dataLayer || [];
				console.log('🎯 GTM dataLayer initialisé:', window.dataLayer);

				class BriefFormWizard {
				constructor() {
					this.currentStep = 1;
					this.totalSteps = 12;
					this.sessionId = this.generateSessionId();
					this.formData = {};
					this.briefId = null;
					this.init();
				}

				generateSessionId() {
					return 'brief_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
				}

				init() {
					// GTM - Tracker début de formulaire
					console.log('🎯 GTM Event: form_started');
					if (typeof dataLayer !== 'undefined') {
						dataLayer.push({
							'event': 'form_started',
							'event_category': 'Brief Form',
							'event_label': 'Form Initialized',
							'step_number': 1
						});
					}

					this.bindEvents();
					this.createPurposeTags();
					this.updateProgress();
					this.initCharCounters();
				}

				bindEvents() {
					const nextBtn = document.getElementById('next-btn');
					const prevBtn = document.getElementById('prev-btn');

					nextBtn.addEventListener('click', () => this.nextStep());
					prevBtn.addEventListener('click', () => this.prevStep());

					// Auto-save sur les changements de champs
					document.addEventListener('input', (e) => {
						if (e.target.matches('input, textarea, select')) {
							this.autoSave();
							this.updateCharCounters(e.target);
						}
					});

					document.addEventListener('change', (e) => {
						if (e.target.matches('input[type="checkbox"], input[type="radio"]')) {
							this.autoSave();
						}
					});
				}

				initCharCounters() {
					// Configuration des compteurs
					const counters = [
						{ textareaId: 'targetRelation', counterId: 'target-char-count', min: 10, recommended: 50 },
						{ textareaId: 'aboutSubject', counterId: 'about-char-count', min: 50, recommended: 200 },
						{ textareaId: 'mainMessage', counterId: 'message-char-count', min: 50, recommended: 200 },
						{ textareaId: 'keywordsAnecdotes', counterId: 'anecdotes-char-count', min: 50, recommended: 200 }
					];

					counters.forEach(config => {
						const textarea = document.getElementById(config.textareaId);
						const counter = document.getElementById(config.counterId);
						
						if (textarea && counter) {
							textarea.addEventListener('input', () => {
								this.updateCharCounter(textarea, counter, config);
							});
						}
					});

					// Compteur d'émotions
					document.addEventListener('change', (e) => {
						if (e.target.matches('input[name="emotions"]')) {
							const emotionCount = document.querySelectorAll('input[name="emotions"]:checked').length;
							const counter = document.getElementById('emotion-selection-count');
							this.updateEmotionCounter(counter, emotionCount, 2);
						}
					});
				}

				updateCharCounter(textarea, counter, config) {
					const currentCount = textarea.value.length;
					
					// Message adapté selon la progression
					let message = `${currentCount} caractères`;
					let colorClass = 'char-counter text-red-400';
					
					if (config.recommended && currentCount >= config.recommended) {
						message += ' ✨ Parfait !';
						colorClass = 'char-counter text-green-400';
					} else if (currentCount >= config.min) {
						if (config.recommended) {
							message += ` (${config.recommended} recommandés)`;
						}
						colorClass = 'char-counter text-yellow-400';
					} else {
						message += ` (minimum ${config.min})`;
						colorClass = 'char-counter text-red-400';
					}
					
					counter.textContent = message;
					counter.className = colorClass;
					
					// Gestion spéciale pour les champs avec maximum
					if (config.max) {
						const percentage = currentCount / config.max;
						counter.textContent = `${currentCount}/${config.max} caractères`;
						
						if (percentage <= 0.8) {
							counter.className = 'char-counter text-green-400';
						} else if (percentage <= 0.95) {
							counter.className = 'char-counter text-yellow-400';
						} else {
							counter.className = 'char-counter text-red-400';
						}
					}
				}

				updateEmotionCounter(counter, current, min) {
					const currentSpan = counter.querySelector('.count-current') || counter;
					
					if (counter.querySelector('.count-current')) {
						currentSpan.textContent = current;
					} else {
						counter.innerHTML = `<span class="count-current">${current}</span> / ${min} émotions minimum`;
					}
					
					// Couleur selon le nombre sélectionné
					if (current >= min) {
						counter.className = 'text-green-400 text-sm';
					} else if (current >= min - 1) {
						counter.className = 'text-yellow-400 text-sm';
					} else {
						counter.className = 'text-red-400 text-sm';
					}
				}

				updateCharCounters(element) {
					const counterId = {
						'targetRelation': 'target-char-count',
						'aboutSubject': 'about-char-count',
						'mainMessage': 'message-char-count',
						'keywordsAnecdotes': 'anecdotes-char-count'
					}[element.id];
					
					if (counterId) {
						const counter = document.getElementById(counterId);
						const config = {
							'target-char-count': { min: 10, recommended: 50 },
							'about-char-count': { min: 50, recommended: 200 },
							'message-char-count': { min: 50, recommended: 200 },
							'anecdotes-char-count': { min: 50, recommended: 200 }
						}[counterId];
						
						if (counter && config) {
							this.updateCharCounter(element, counter, config);
						}
					}
				}

				createPurposeTags() {
					const container = document.getElementById('purpose-tags');
					
					const tags = [
						{ name: 'Anniversaire', color: 'bg-purple-500', textColor: 'text-purple-100' },
						{ name: 'Club', color: 'bg-purple-600', textColor: 'text-purple-100' },
						{ name: 'Entreprise', color: 'bg-blue-500', textColor: 'text-blue-100' },
						{ name: 'Association', color: 'bg-green-500', textColor: 'text-green-100' },
						{ name: 'Amour', color: 'bg-pink-400', textColor: 'text-pink-100' },
						{ name: 'Nouvelle vie', color: 'bg-pink-500', textColor: 'text-pink-100' },
						{ name: 'Départ à l\'étranger', color: 'bg-cyan-500', textColor: 'text-cyan-100' },
						{ name: 'Départ à la retraite', color: 'bg-yellow-500', textColor: 'text-yellow-900' },
						{ name: 'Permis de conduire', color: 'bg-red-500', textColor: 'text-red-100' },
						{ name: 'Diplôme', color: 'bg-indigo-500', textColor: 'text-indigo-100' },
						{ name: 'Mariage', color: 'bg-rose-500', textColor: 'text-rose-100' },
						{ name: 'Naissance', color: 'bg-emerald-500', textColor: 'text-emerald-100' },
						{ name: 'Amitié', color: 'bg-teal-500', textColor: 'text-teal-100' },
						{ name: 'Autre', color: 'bg-gray-500', textColor: 'text-gray-100' }
					];

					tags.forEach(tag => {
						const tagElement = document.createElement('button');
						tagElement.className = `purpose-tag px-4 py-3 rounded-full text-sm font-medium transition-all hover:scale-105 border-2 border-transparent ${tag.color} bg-opacity-20 ${tag.textColor} hover:bg-opacity-30`;
						tagElement.dataset.tag = tag.name;
						tagElement.textContent = tag.name;

						tagElement.addEventListener('click', () => this.selectPurpose(tag.name, tagElement));
						container.appendChild(tagElement);
					});
				}

				selectPurpose(tag, element) {
					// Désélectionner tous les autres
					document.querySelectorAll('.purpose-tag').forEach(opt => {
						opt.classList.remove('border-[#c76927]', 'bg-opacity-40');
						opt.classList.add('bg-opacity-20', 'border-transparent');
					});

					// Sélectionner celui-ci
					element.classList.remove('border-transparent', 'bg-opacity-20');
					element.classList.add('border-[#c76927]', 'bg-opacity-40');

					// GTM - Tracker sélection objectif
					console.log(`🎯 GTM Event: form_purpose_selected - ${tag}`);
					if (typeof dataLayer !== 'undefined') {
						dataLayer.push({
							'event': 'form_purpose_selected',
							'event_category': 'Brief Form',
							'event_label': tag,
							'purpose_type': tag,
							'step_number': 3
						});
					}

					// Gérer le champ "Autre"
					const otherField = document.getElementById('other-purpose-field');
					if (tag === 'Autre') {
						otherField.classList.remove('hidden');
						document.getElementById('otherPurpose').focus();
					} else {
						otherField.classList.add('hidden');
						document.getElementById('otherPurpose').value = '';
					}

					this.formData.purposeTag = tag;
					this.updatePlaceholders(tag);
					this.autoSave();
				}

				updatePlaceholders(tag) {
					// Mettre à jour les placeholders selon la catégorie
					const targetTextarea = document.getElementById('targetAudience');
					const messageTextarea = document.getElementById('mainMessage');
					const targetExample = document.getElementById('target-example');
					const messageExample = document.getElementById('message-example');

					const examples = {
						'Anniversaire': {
							target: 'Ex: Mon fils, ma femme, mon père...',
							message: 'Ex: Dire à mon fils à quel point je suis fier de lui et qu\'il peut réaliser tous ses rêves',
							targetDesc: 'Qui fête son anniversaire ?'
						},
						'Entreprise': {
							target: 'Ex: Mes employés, mes clients, mon équipe...',
							message: 'Ex: Remercier nos employés pour leur dévouement et les motiver pour l\'année à venir',
							targetDesc: 'À qui s\'adresse cette chanson d\'entreprise ?'
						},
						'Mariage': {
							target: 'Ex: Ma future épouse, mon futur mari...',
							message: 'Ex: Exprimer mon amour éternel et ma joie de construire notre vie ensemble',
							targetDesc: 'Qui se marie ?'
						}
					};

					const example = examples[tag] || {
						target: 'Ex: Cette personne spéciale...',
						message: 'Ex: Le message que vous voulez transmettre...',
						targetDesc: 'Décrivez votre relation avec cette personne'
					};

					if (targetTextarea) targetTextarea.placeholder = example.target;
					if (messageTextarea) messageTextarea.placeholder = example.message;
					if (targetExample) targetExample.textContent = example.targetDesc;
				}

				async nextStep() {
					if (!this.validateCurrentStep()) {
						this.showValidationError();
						return;
					}

					// GTM - Tracker progression étapes
					console.log(`🎯 GTM Event: form_step_completed - Step ${this.currentStep}`);
					if (typeof dataLayer !== 'undefined') {
						dataLayer.push({
							'event': 'form_step_completed',
							'event_category': 'Brief Form',
							'event_label': `Step ${this.currentStep}`,
							'step_number': this.currentStep,
							'step_name': this.getStepName(this.currentStep)
						});
					}

					if (this.currentStep < this.totalSteps) {
						this.hideStep(this.currentStep);
						this.currentStep++;
						
						// GTM - Nouvelle étape commencée
						console.log(`🎯 GTM Event: form_step_started - Step ${this.currentStep}`);
						if (typeof dataLayer !== 'undefined') {
							dataLayer.push({
								'event': 'form_step_started',
								'event_category': 'Brief Form',
								'event_label': `Step ${this.currentStep}`,
								'step_number': this.currentStep,
								'step_name': this.getStepName(this.currentStep)
							});
						}

						this.showStep(this.currentStep);
						this.updateProgress();
						await this.autoSave();
					} else if (this.currentStep === this.totalSteps) {
						// GTM Tracking - Formulaire terminé
						// GTM - Formulaire terminé
						console.log('🎯 GTM Event: form_completed');
						if (typeof dataLayer !== 'undefined') {
							dataLayer.push({
								'event': 'form_completed',
								'event_category': 'Brief Form',
								'event_label': 'All Steps Completed',
								'value': 160
							});
						}
						
						// Étape 11 terminée, rediriger vers le paiement
						await this.proceedToPayment();
					}
				}

				validateCurrentStep() {
					switch (this.currentStep) {
						case 1:
							const firstName = document.getElementById('firstName').value.trim();
							const lastName = document.getElementById('lastName').value.trim();
							const email = document.getElementById('email').value.trim();
							const phone = document.getElementById('phone').value.trim();
							return firstName && lastName && email && phone;
						case 2:
							return true; // Slide inspirante, pas de validation
						case 3:
							if (this.formData.purposeTag === 'Autre') {
								const otherText = document.getElementById('otherPurpose').value.trim();
								return this.formData.purposeTag && otherText.length > 0;
							}
							return this.formData.purposeTag;
						case 4:
							const targetFirstName = document.getElementById('targetFirstName').value.trim();
							const targetLastName = document.getElementById('targetLastName').value.trim();
							const targetBirthDate = document.getElementById('targetBirthDate').value.trim();
							const targetGender = document.getElementById('targetGender').value.trim();
							const targetRelation = document.getElementById('targetRelation').value.trim();
							return targetFirstName && targetLastName && targetBirthDate && targetGender && targetRelation.length >= 10;
						case 5:
							const checkedEmotions = document.querySelectorAll('input[name="emotions"]:checked');
							return checkedEmotions.length >= 2;
						case 6:
							const aboutSubject = document.getElementById('aboutSubject').value.trim();
							return aboutSubject.length >= 50;
						case 7:
							const mainMessage = document.getElementById('mainMessage').value.trim();
							return mainMessage.length >= 50;
						case 8:
							const anecdotes = document.getElementById('keywordsAnecdotes').value.trim();
							return anecdotes.length >= 50;
						case 9:
							const selectedStyles = document.querySelectorAll('input[name="musicStyle"]:checked');
							return selectedStyles.length >= 1 && selectedStyles.length <= 2;
						case 10:
							return true; // Titre optionnel
						case 11:
							return true; // Inspirations optionnelles
						case 12:
							return true; // Sujets sensibles optionnels
						default:
							return true;
					}
				}

				collectFormData() {
					const data = { ...this.formData };

					// Étape 1 - Informations personnelles
					data.firstName = document.getElementById('firstName')?.value || '';
					data.lastName = document.getElementById('lastName')?.value || '';
					data.email = document.getElementById('email')?.value || '';
					data.phone = document.getElementById('phone')?.value || '';

					// Étape 3 - Catégorie (avec cas "Autre")
					if (this.formData.purposeTag === 'Autre') {
						data.purposeTag = document.getElementById('otherPurpose')?.value || 'Autre';
					}

					// Étape 4 - Informations sur la personne cible
					data.targetFirstName = document.getElementById('targetFirstName')?.value || '';
					data.targetLastName = document.getElementById('targetLastName')?.value || '';
					data.targetBirthDate = document.getElementById('targetBirthDate')?.value || '';
					data.targetGender = document.getElementById('targetGender')?.value || '';
					data.targetRelation = document.getElementById('targetRelation')?.value || '';

					// Étape 5 - Émotions
					const emotions = Array.from(document.querySelectorAll('input[name="emotions"]:checked'))
						.map(input => input.value);
					data.emotions = emotions;

					// Étape 6 - Parlez-nous de cette personne
					data.aboutSubject = document.getElementById('aboutSubject')?.value || '';

					// Étape 7 - Message à faire passer
					data.mainMessage = document.getElementById('mainMessage')?.value || '';

					// Étape 8 - Mots-clés et anecdotes
					data.keywordsAnecdotes = document.getElementById('keywordsAnecdotes')?.value || '';

					// Étape 9 - Styles musicaux (plusieurs possibles)
					const selectedStyles = Array.from(document.querySelectorAll('input[name="musicStyle"]:checked'))
						.map(input => input.value);
					data.musicStyle = selectedStyles.join(', ');

					// Étape 10 - Titre de la chanson
					data.songTitle = document.getElementById('songTitle')?.value || '';

					// Étape 11 - Inspirations
					const inspirations = Array.from(document.querySelectorAll('input[name="inspiration"]'))
						.map(input => input.value)
						.filter(value => value.trim() !== '');
					data.artistInspirations = inspirations;

					// Étape 12 - Sujets sensibles
					data.sensitiveTopics = document.getElementById('sensitiveTopics')?.value || '';

					return data;
				}

				async autoSave() {
					const data = this.collectFormData();
					data.sessionId = this.sessionId;
					data.currentStep = this.currentStep;

					try {
						const response = await fetch('/api/briefs/save-step', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(data)
						});

						const result = await response.json();
						
						if (result.success) {
							console.log('✅ Brief sauvegardé automatiquement');
							this.briefId = result.briefId;
						} else {
							console.error('❌ Erreur sauvegarde:', result.message);
						}
					} catch (error) {
						console.error('❌ Erreur réseau:', error);
					}
				}

				async proceedToPayment() {
					// GTM - Tracker redirection vers paiement (begin_checkout GA4)
					console.log('🎯 GTM Event: begin_checkout');
					if (typeof dataLayer !== 'undefined') {
						dataLayer.push({
							'event': 'begin_checkout',
							'currency': 'EUR',
							'value': 160,
							'items': [{
								'item_id': 'chanson-personnalisee',
								'item_name': 'Chanson Personnalisée Poppy Music',
								'item_category': 'Music Production',
								'price': 160,
								'quantity': 1
							}]
						});
					}

					this.formData.isCompleted = true;
					await this.autoSave();
					window.location.href = `/payment?briefId=${this.briefId}&sessionId=${this.sessionId}`;
				}

				prevStep() {
					if (this.currentStep > 1) {
						// Analytics - Tracker retour en arrière
					if (typeof gtag !== 'undefined') {
						gtag('event', 'form_step_back', {
							'event_category': 'Brief Form',
							'event_label': `Back from Step ${this.currentStep} to ${this.currentStep - 1}`,
							'step_number': this.currentStep
						});
					}

						this.hideStep(this.currentStep);
						this.currentStep--;
						this.showStep(this.currentStep);
						this.updateProgress();
					}
				}

				getStepName(step) {
					const stepNames = {
						1: 'Informations personnelles',
						2: 'Inspiration',
						3: 'Objectif de la chanson',
						4: 'Personne ciblée',
						5: 'Émotions à transmettre',
						6: 'À propos du sujet',
						7: 'Message principal',
						8: 'Mots-clés et anecdotes',
						9: 'Univers musical',
						10: 'Titre de la chanson',
						11: 'Sujets sensibles'
					};
					return stepNames[step] || `Étape ${step}`;
				}

				initStepEvents(step) {
					if (step === 9) {
						// Initialiser les événements des styles musicaux
						document.querySelectorAll('.music-style-option').forEach(option => {
							option.addEventListener('click', () => {
								const checkbox = option.querySelector('input[type="checkbox"]');
								const currentChecked = document.querySelectorAll('input[name="musicStyle"]:checked').length;
								
								if (checkbox.checked) {
									// Décocher
									checkbox.checked = false;
									option.classList.remove('border-[#c76927]', 'bg-[#c76927]', 'bg-opacity-10');
									option.classList.add('border-gray-700');
								} else {
									// Vérifier la limite de 2 choix
									if (currentChecked >= 2) {
										alert('Vous ne pouvez sélectionner que 2 styles maximum');
										return;
									}
									// Cocher
									checkbox.checked = true;
									option.classList.remove('border-gray-700');
									option.classList.add('border-[#c76927]', 'bg-[#c76927]', 'bg-opacity-10');
								}
								
								// Mettre à jour le compteur
								const newCount = document.querySelectorAll('input[name="musicStyle"]:checked').length;
								document.getElementById('music-selection-count').textContent = `${newCount} / 2 styles sélectionnés`;
								
								this.autoSave();
							});
						});
					}

					if (step === 11) {
						// Initialiser les événements des inspirations
						this.initInspirationEvents();
					}
				}

				initInspirationEvents() {
					const addBtn = document.getElementById('add-inspiration');
					if (addBtn) {
						addBtn.replaceWith(addBtn.cloneNode(true));
						const newAddBtn = document.getElementById('add-inspiration');
						newAddBtn.addEventListener('click', () => {
							this.addInspirationInput();
						});
					}
				}

				addInspirationInput() {
					const container = document.getElementById('inspiration-inputs');
					const inputGroup = document.createElement('div');
					inputGroup.className = 'inspiration-input-group flex gap-2 mb-4';
					
					inputGroup.innerHTML = `
						<input type="text" name="inspiration" placeholder="Artiste, chanson ou lien..."
							class="flex-1 px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
						<button type="button" class="remove-inspiration px-3 py-3 text-gray-400 hover:text-red-400 transition-colors">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
							</svg>
						</button>
					`;

					inputGroup.querySelector('.remove-inspiration').addEventListener('click', () => {
						inputGroup.remove();
						this.updateRemoveButtons();
						this.autoSave();
					});

					container.appendChild(inputGroup);
					this.updateRemoveButtons();
				}

				updateRemoveButtons() {
					const groups = document.querySelectorAll('.inspiration-input-group');
					groups.forEach(group => {
						const removeBtn = group.querySelector('.remove-inspiration');
						if (groups.length > 1) {
							removeBtn.style.display = 'block';
						} else {
							removeBtn.style.display = 'none';
						}
					});
				}

				// Fonctions utilitaires...
				showStep(step) {
					const stepElement = document.getElementById(`step-${step}`);
					if (stepElement) {
						stepElement.classList.add('active');
					}
					this.initStepEvents(step);
					window.scrollTo({ top: 0, behavior: 'smooth' });
				}

				hideStep(step) {
					const stepElement = document.getElementById(`step-${step}`);
					if (stepElement) {
						stepElement.classList.remove('active');
					}
				}

				updateProgress() {
					const progressPercent = Math.round((this.currentStep / this.totalSteps) * 100);
					document.getElementById('current-step').textContent = this.currentStep;
					document.getElementById('progress-percent').textContent = progressPercent;
					document.getElementById('progress-bar').style.width = progressPercent + '%';

					const prevBtn = document.getElementById('prev-btn');
					const nextBtn = document.getElementById('next-btn');

					prevBtn.disabled = this.currentStep === 1;
					nextBtn.textContent = this.currentStep === this.totalSteps ? 'Finaliser le brief' : 'Suivant →';
				}

				showValidationError() {
					alert('Veuillez remplir tous les champs requis avant de continuer.');
				}
			}

			// Initialiser le wizard au chargement de la page
			let briefWizard;
			document.addEventListener('DOMContentLoaded', () => {
				briefWizard = new BriefFormWizard();
			});

			// Analytics - Tracker abandon de formulaire
			window.addEventListener('beforeunload', () => {
				if (briefWizard && briefWizard.currentStep < briefWizard.totalSteps && !briefWizard.formData.isCompleted && typeof gtag !== 'undefined') {
					gtag('event', 'form_abandoned', {
						'event_category': 'Brief Form',
						'event_label': `Abandoned at Step ${briefWizard.currentStep}`,
						'step_number': briefWizard.currentStep,
						'step_name': briefWizard.getStepName(briefWizard.currentStep)
					});
				}
			});
			} // Fin de la vérification typeof window
		</script>

		<style>
			.step-content {
				display: none;
			}
			
			.step-content.active {
				display: block;
				animation: fadeIn 0.3s ease-in-out;
			}

			@keyframes fadeIn {
				from { opacity: 0; transform: translateY(10px); }
				to { opacity: 1; transform: translateY(0); }
			}

			.purpose-tag.selected {
				border-color: #c76927 !important;
				background-color: rgba(199, 105, 39, 0.4) !important;
			}

			.emotion-option:has(input:checked) {
				border-color: #c76927;
				background-color: rgba(199, 105, 39, 0.1);
			}

			.emotion-option:has(input:checked) .text-white {
				color: #c76927 !important;
				font-weight: 600;
			}

			.emotion-option:has(input:checked) .text-gray-400 {
				color: #d1d5db !important;
			}

			.music-style-option:has(input:checked) {
				border-color: #c76927 !important;
				background-color: rgba(199, 105, 39, 0.1);
			}

			.music-style-option:has(input:checked) .text-white {
				color: #c76927 !important;
				font-weight: 600;
			}

			.music-style-option:has(input:checked) .text-gray-400 {
				color: #d1d5db !important;
			}

			.char-counter {
				transition: color 0.3s ease;
				font-weight: 500;
			}

			.char-counter.text-green-400 {
				color: #10b981;
			}

			.char-counter.text-yellow-400 {
				color: #f59e0b;
			}

			.char-counter.text-red-400 {
				color: #ef4444;
			}

			.char-counter .count-current {
				font-weight: 600;
			}
		</style>

		<!-- FOOTER DISCRET -->
		<footer class="border-t border-gray-800 py-6 mt-12">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<p class="text-gray-500 text-xs">
					© 2025 Wardogz - Poppy Music. Tous droits réservés. 
					<a href="/cgv" class="text-gray-400 hover:text-[#c76927] transition-colors ml-2">CGV</a>
				</p>
			</div>
		</footer>
	</body>
</html>
