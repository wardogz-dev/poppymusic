---
import '../styles/global.css';
import GTM from '../components/GTM.astro';
import GTMInit from '../components/GTMInit.astro';

const title = "Créer ma chanson - Poppy Music";
const description = "Créez votre chanson personnalisée en quelques étapes simples.";
const image = "https://poppymusic.fr/og-image.png?v=3";
const url = "https://poppymusic.fr/brief";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- Favicon -->
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Google Tag Manager -->
		<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-NGZ6SCTP');</script>
		<!-- End Google Tag Manager -->

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-7XM9JLS953"></script>
		<script>
			// @ts-nocheck
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-7XM9JLS953');
		</script>
	</head>
	
	<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased min-h-screen">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NGZ6SCTP"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<!-- HEADER MINIMAL -->
		<header class="fixed top-0 left-0 right-0 z-50 bg-[#0B0B0B] bg-opacity-95 backdrop-blur-sm border-b border-gray-800">
			<nav class="flex justify-between items-center px-4 sm:px-8 py-4">
				<a href="/" class="title-artistic text-xl sm:text-2xl text-[#c76927] hover:opacity-80 transition-opacity">Poppy Music</a>
				<div class="flex items-center gap-4">
					<div class="text-artistic text-xs sm:text-sm text-gray-400 uppercase tracking-wider">Créer ma chanson</div>
					<div class="bg-[#c76927] text-black px-3 py-1 rounded-full text-sm font-bold">160€</div>
				</div>
			</nav>
		</header>

		<!-- PROGRESS BAR -->
		<div class="fixed top-16 left-0 right-0 z-40 bg-[#0B0B0B] bg-opacity-95 backdrop-blur-sm border-b border-gray-800">
			<div class="px-4 sm:px-8 py-3">
				<div class="flex items-center justify-between mb-2">
					<span class="text-sm text-gray-400">Étape <span id="current-step">1</span> sur 12</span>
					<span class="text-sm text-gray-400"><span id="progress-percent">8</span>%</span>
				</div>
					<div class="w-full bg-gray-800 rounded-full h-2">
						<div id="progress-bar" class="bg-[#c76927] h-2 rounded-full transition-all duration-500" style="width: 8%"></div>
					</div>
			</div>
		</div>

		<!-- MAIN CONTENT -->
		<main class="pt-32 pb-24 min-h-screen flex items-center justify-center">
			<div class="w-full max-w-2xl mx-auto px-4 sm:px-6">
				
				<!-- FORM CONTAINER -->
				<div id="form-container" class="relative">
					
					<!-- ÉTAPE 1: INFORMATIONS PERSONNELLES -->
					<div id="step-1" class="step-content active">
						<div class="text-center mb-8">
							<h1 class="title-artistic text-3xl sm:text-4xl text-white mb-4">
								Pour commencer,<br/>
								<span class="text-[#c76927]">présentez-vous</span>
							</h1>
							<p class="text-gray-400 text-lg">Nous avons besoin de quelques informations pour personnaliser votre expérience</p>
						</div>

						<div class="space-y-6">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label for="firstName" class="block text-sm font-medium text-gray-300 mb-2">Prénom *</label>
									<input type="text" id="firstName" name="firstName" required 
										class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
								</div>
								<div>
									<label for="lastName" class="block text-sm font-medium text-gray-300 mb-2">Nom *</label>
									<input type="text" id="lastName" name="lastName" required 
										class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
								</div>
							</div>
							<div>
								<label for="email" class="block text-sm font-medium text-gray-300 mb-2">Email *</label>
								<input type="email" id="email" name="email" required 
									class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
							</div>
							<div>
								<label for="phone" class="block text-sm font-medium text-gray-300 mb-2">Téléphone *</label>
								<input type="tel" id="phone" name="phone" required 
									class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
							</div>
						</div>
					</div>

					<!-- ÉTAPE 2: SLIDE INSPIRANTE -->
					<div id="step-2" class="step-content">
						<div class="text-center">
							<div class="mb-8">
								<div class="w-20 h-20 bg-[#c76927] bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-6">
									<span class="text-[#c76927] text-4xl">🎵</span>
								</div>
								<h1 class="title-artistic text-3xl sm:text-4xl text-white mb-6 leading-tight">
									Vous entrez maintenant dans un<br/>
									<span class="text-[#c76927]">processus de création</span>
								</h1>
							</div>

							<div class="max-w-2xl mx-auto space-y-6 text-lg text-gray-300 leading-relaxed">
								<p class="text-xl text-[#c76927] font-medium">
									Plus vous nous donnerez d'informations précises,<br/>
									plus nous pourrons créer un son qui dépassera vos attentes.
								</p>
								
								<div class="bg-gray-900 bg-opacity-50 rounded-lg p-6">
									<p class="text-gray-300 mb-4">
										<strong class="text-white">Prenez le temps</strong> de nous raconter votre histoire comme vous la ressentez.
									</p>
									<p class="text-gray-400">
										Écrivez comme vous le sentez, pas la peine de vous embêter avec la forme. 
										<strong class="text-[#c76927]">Nous avons besoin de comprendre l'essence de votre projet</strong> - 
										nous nous occupons de la forme.
									</p>
								</div>

								<div class="flex items-center justify-center gap-8 text-sm text-gray-500 mt-8">
									<div class="flex items-center gap-2">
										<span class="w-2 h-2 bg-[#c76927] rounded-full"></span>
										<span>Votre histoire</span>
									</div>
									<div class="flex items-center gap-2">
										<span class="w-2 h-2 bg-[#c76927] rounded-full"></span>
										<span>Notre créativité</span>
									</div>
									<div class="flex items-center gap-2">
										<span class="w-2 h-2 bg-[#c76927] rounded-full"></span>
										<span>Ma chanson</span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- ÉTAPE 3: POURQUOI CETTE CHANSON -->
					<div id="step-3" class="step-content">
						<div class="text-center mb-8">
							<h1 class="title-artistic text-3xl sm:text-4xl text-white mb-4">
								Pourquoi voulez-vous<br/>
								<span class="text-[#c76927]">créer cette chanson ?</span>
							</h1>
							<p class="text-gray-400 text-lg">Choisissez la catégorie qui correspond le mieux à votre projet</p>
						</div>

						<div class="flex flex-wrap justify-center gap-3" id="purpose-tags">
							<!-- Tags générés dynamiquement -->
						</div>

						<!-- CHAMP AUTRE (masqué par défaut) -->
						<div id="other-purpose-field" class="mt-6 hidden">
							<label for="otherPurpose" class="block text-sm font-medium text-gray-300 mb-2">Précisez votre cas :</label>
							<input type="text" id="otherPurpose" name="otherPurpose" 
								placeholder="Ex: Cadeau de réconciliation, surprise pour ma grand-mère..."
								class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
						</div>
					</div>

					<!-- ÉTAPE 4: QUI EST CETTE PERSONNE POUR VOUS -->
					<div id="step-4" class="step-content">
						<div class="text-center mb-8">
							<h1 class="title-artistic text-3xl sm:text-4xl text-white mb-4">
								Qui est cette personne<br/>
								<span class="text-[#c76927]">pour vous ?</span>
							</h1>
							<p class="text-gray-400 text-lg" id="target-example">Parlez-nous de cette personne spéciale</p>
						</div>

						<div class="space-y-6">
							<!-- Informations de base -->
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label for="targetFirstName" class="block text-sm font-medium text-gray-300 mb-2">Prénom de la personne *</label>
									<input type="text" id="targetFirstName" name="targetFirstName" required 
										placeholder="Ex: Lucas, Marie, Jean..."
										class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
								</div>
								<div>
									<label for="targetLastName" class="block text-sm font-medium text-gray-300 mb-2">Nom de famille *</label>
									<input type="text" id="targetLastName" name="targetLastName" required 
										placeholder="Ex: Dupont, Martin..."
										class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
								</div>
							</div>

							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div>
									<label for="targetBirthDate" class="block text-sm font-medium text-gray-300 mb-2">Date de naissance *</label>
									<input type="date" id="targetBirthDate" name="targetBirthDate" required 
										class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
								</div>
								<div>
									<label for="targetGender" class="block text-sm font-medium text-gray-300 mb-2">Genre *</label>
									<select id="targetGender" name="targetGender" required 
										class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all">
										<option value="">Choisir...</option>
										<option value="homme">Homme</option>
										<option value="femme">Femme</option>
									</select>
								</div>
							</div>

							<!-- Relation -->
							<div>
								<label for="targetRelation" class="block text-sm font-medium text-gray-300 mb-2">Qui est cette personne pour vous ? *</label>
								<textarea id="targetRelation" name="targetRelation" rows="3" required 
									placeholder=""
									minlength="10"
									class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all resize-none"></textarea>
							<div class="text-right text-xs mt-1">
								<span id="target-char-count" class="char-counter" data-min="10" data-current="0">
									<span class="count-current">0</span> / <span class="count-min">10</span> caractères minimum
								</span>
							</div>
							</div>
						</div>
					</div>

					<!-- ÉTAPE 5: ÉMOTIONS -->
					<div id="step-5" class="step-content">
						<div class="text-center mb-8">
							<h1 class="title-artistic text-3xl sm:text-4xl text-white mb-4">
								Quelles émotions voulez-vous<br/>
								<span class="text-[#c76927]">transmettre ?</span>
							</h1>
							<p class="text-gray-400 text-lg">Sélectionnez au minimum 2 émotions qui correspondent à votre message</p>
						</div>

						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="joie" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">😊 Joie</span>
									<p class="text-gray-400 text-xs">énergie, euphorie, célébration</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="amour" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">❤️ Amour</span>
									<p class="text-gray-400 text-xs">tendresse, passion, douceur</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="colere" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">😡 Colère</span>
									<p class="text-gray-400 text-xs">rage, frustration, rébellion</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="espoir" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">✨ Espoir</span>
									<p class="text-gray-400 text-xs">élan, inspiration, lumière</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="excitation" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🎉 Excitation</span>
									<p class="text-gray-400 text-xs">adrénaline, fête, impatience</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="desir" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">💋 Désir</span>
									<p class="text-gray-400 text-xs">envie, sensualité, séduction</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="solitude" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🌙 Solitude</span>
									<p class="text-gray-400 text-xs">isolement, vide, introspection</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="fierte" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🏆 Fierté</span>
									<p class="text-gray-400 text-xs">puissance, accomplissement, dignité</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="spiritualite" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🙏 Spiritualité</span>
									<p class="text-gray-400 text-xs">élévation, transcendance, mysticisme</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="humour" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">😄 Humour</span>
									<p class="text-gray-400 text-xs">légèreté, ironie, jeu</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="nostalgie" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🌅 Nostalgie</span>
									<p class="text-gray-400 text-xs">souvenirs, temps passé, chaleur</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="determination" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">💪 Détermination</span>
									<p class="text-gray-400 text-xs">courage, force intérieure, persévérance</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="liberte" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🕊️ Liberté</span>
									<p class="text-gray-400 text-xs">émancipation, ouverture, voyage</p>
								</div>
							</label>
							<label class="emotion-option flex items-start space-x-3 p-4 border border-gray-700 rounded-md cursor-pointer hover:border-[#c76927] transition-colors">
								<input type="checkbox" name="emotions" value="gratitude" class="w-4 h-4 text-[#c76927] bg-gray-800 border-gray-600 rounded focus:ring-[#c76927] mt-1">
								<div>
									<span class="text-white font-medium">🙏 Gratitude</span>
									<p class="text-gray-400 text-xs">reconnaissance, chaleur, connexion</p>
								</div>
							</label>
						</div>
						<p class="text-center text-red-400 text-sm mt-4" id="emotion-selection-count">
							<span class="count-current">0</span> / 2 émotions minimum
						</p>
					</div>

					<!-- ÉTAPE 6: PARLEZ-NOUS DE CETTE PERSONNE -->
					<div id="step-6" class="step-content">
						<div class="text-center mb-8">
							<h1 class="title-artistic text-3xl sm:text-4xl text-white mb-4">
								Parlez-nous de<br/>
								<span class="text-[#c76927]">cette personne</span>
							</h1>
							<p class="text-gray-400 text-lg">Plus vous nous en direz, plus la chanson sera personnalisée</p>
						</div>

						<div>
							<textarea id="aboutSubject" name="aboutSubject" rows="7" required 
								minlength="50"
								placeholder="Ex: Mon fils Lucas, 10 ans, passionné de football et de jeux vidéo, très timide mais adorable. Il adore les histoires de super-héros et rêve de devenir astronaute. C'est un enfant sensible qui a parfois du mal à exprimer ses émotions mais qui a un cœur en or..."
								class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] focus:border-transparent transition-all resize-none"></textarea>
							<div class="text-right text-xs mt-1">
								<span id="about-char-count" class="char-counter" data-min="200" data-current="0">
									<span class="count-current">0</span> / <span class="count-min">200</span> caractères minimum
								</span>
							</div>
						</div>
					</div>

					<!-- ÉTAPE 7: MESSAGE À FAIRE PASSER -->
					<div id="step-7" class="step-content">
						<div class="text-center mb-8">
