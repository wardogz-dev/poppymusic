---
import '../../styles/global.css';

export const prerender = false;

const title = "Dashboard Admin - Poppy Music";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<meta name="robots" content="noindex, nofollow" />
		<script src="https://unpkg.com/@supabase/supabase-js@2"></script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-7XM9JLS953"></script>
		<script>
			// @ts-nocheck
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-7XM9JLS953');
		</script>
	</head>
	
	<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased">
		<!-- HEADER ADMIN -->
		<header class="bg-gray-900 border-b border-gray-800">
			<nav class="flex flex-col sm:flex-row justify-between items-start sm:items-center px-4 sm:px-8 py-4 gap-4">
				<div class="flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-6 w-full sm:w-auto">
					<h1 class="title-artistic text-sm sm:text-xl sm:text-2xl text-[#c76927]">Poppy Music Admin</h1>
					<div class="flex space-x-4">
						<a href="/admin/dashboard" class="text-[#c76927] border-b-2 border-[#c76927] pb-1 text-sm sm:text-base">Dashboard</a>
						<a href="/admin/briefs" class="text-gray-400 hover:text-white transition-colors text-sm sm:text-base">Briefs</a>
					</div>
				</div>
				<div class="flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-4 w-full sm:w-auto">
					<span class="text-xs sm:text-sm text-gray-400">Connecté: <span id="adminUsername" class="text-white">admin</span></span>
					<button id="logoutBtn" class="text-gray-400 hover:text-red-400 transition-colors text-sm">Déconnexion</button>
				</div>
			</nav>
		</header>

		<!-- MAIN CONTENT -->
		<main class="p-4 sm:p-8">
			<div class="max-w-7xl mx-auto">
				<!-- STATISTIQUES -->
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6 mb-8">
					<div class="bg-gray-900 rounded-lg p-3 sm:p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-xs sm:text-xs sm:text-sm font-medium text-gray-400">Total Briefs</p>
								<p id="totalBriefs" class="text-2xl sm:text-2xl sm:text-3xl font-bold text-white">-</p>
							</div>
							<div class="w-8 h-8 sm:w-12 sm:h-12 bg-[#c76927] bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-[#c76927] text-sm sm:text-sm sm:text-xl">📝</span>
							</div>
						</div>
					</div>

					<div class="bg-gray-900 rounded-lg p-3 sm:p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-xs sm:text-xs sm:text-sm font-medium text-gray-400">En attente</p>
								<p id="pendingBriefs" class="text-2xl sm:text-2xl sm:text-3xl font-bold text-yellow-400">-</p>
							</div>
							<div class="w-8 h-8 sm:w-12 sm:h-12 bg-yellow-400 bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-yellow-400 text-sm sm:text-sm sm:text-xl">⏳</span>
							</div>
						</div>
					</div>

					<div class="bg-gray-900 rounded-lg p-3 sm:p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-xs sm:text-sm font-medium text-gray-400">En cours</p>
								<p id="inProgressBriefs" class="text-2xl sm:text-3xl font-bold text-blue-400">-</p>
							</div>
							<div class="w-8 h-8 sm:w-12 sm:h-12 bg-blue-400 bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-blue-400 text-sm sm:text-xl">🎵</span>
							</div>
						</div>
					</div>

					<div class="bg-gray-900 rounded-lg p-3 sm:p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-xs sm:text-sm font-medium text-gray-400">Revenus</p>
								<p id="totalRevenue" class="text-2xl sm:text-3xl font-bold text-green-400">-</p>
							</div>
							<div class="w-8 h-8 sm:w-12 sm:h-12 bg-green-400 bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-green-400 text-sm sm:text-xl">💰</span>
							</div>
						</div>
					</div>
				</div>

				<!-- BRIEFS RÉCENTS -->
				<div class="bg-gray-900 rounded-lg">
					<div class="p-6 border-b border-gray-800">
						<div class="flex justify-between items-center">
							<h2 class="text-sm sm:text-xl font-bold text-white">Demandes récentes</h2>
							<a href="/admin/briefs" class="text-[#c76927] hover:text-white transition-colors">Voir tout →</a>
						</div>
					</div>
					
					<!-- Version desktop -->
					<div class="hidden md:block overflow-x-auto">
						<table class="w-full">
							<thead class="bg-gray-800">
								<tr>
									<th class="text-left p-4 text-xs sm:text-sm font-medium text-gray-300">Client</th>
									<th class="text-left p-4 text-xs sm:text-sm font-medium text-gray-300">Projet</th>
									<th class="text-left p-4 text-xs sm:text-sm font-medium text-gray-300">Style</th>
									<th class="text-left p-4 text-xs sm:text-sm font-medium text-gray-300">Délai</th>
									<th class="text-left p-4 text-xs sm:text-sm font-medium text-gray-300">Statut</th>
									<th class="text-left p-4 text-xs sm:text-sm font-medium text-gray-300">Actions</th>
								</tr>
							</thead>
							<tbody id="recentBriefs" class="divide-y divide-gray-800">
								<tr>
									<td colspan="6" class="p-8 text-center text-gray-400">
										<div class="flex flex-col items-center">
											<span class="text-4xl mb-2">🎵</span>
											<p>Chargement des demandes...</p>
										</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
					
					<!-- Version mobile -->
					<div id="recentBriefsMobile" class="md:hidden space-y-4">
						<div class="p-4 text-center text-gray-400">
							<div class="flex flex-col items-center">
								<span class="text-4xl mb-2">🎵</span>
								<p>Chargement des demandes...</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</main>

		<script>
			// @ts-nocheck
			// Attendre que Supabase soit chargé
			window.addEventListener('load', function() {
				// Configuration Supabase
				const supabase = window.supabase.createClient(
					'https://ntvnhcpkzpovqgcaiawx.supabase.co',
					'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im50dm5oY3BrenBvdnFnY2FpYXd4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTY2NTg5OTgsImV4cCI6MjA3MjIzNDk5OH0.GQfgar4VTEz3H73usQRb9Vqa3gBfOfomZgXjPlasTSw'
				);

			// Services
			const AuthService = {
				isAdminLoggedIn() {
					const session = localStorage.getItem('poppy_admin_session');
					if (!session) return false;
					try {
						const { loginTime } = JSON.parse(session);
						return Date.now() - loginTime < 24 * 60 * 60 * 1000;
					} catch { return false; }
				},
				logout() { localStorage.removeItem('poppy_admin_session'); }
			};

			const BriefService = {
				async getDashboardStats() {
					const { data: briefs, error } = await supabase
						.from('client_briefs_steps')
						.select('is_completed, is_paid, amount_paid, current_step');
					
					if (error) throw error;
					
					return {
						total_briefs: briefs.length,
						pending_briefs: briefs.filter(b => !b.is_completed && (b.current_step || 1) < 12).length,
						in_progress_briefs: briefs.filter(b => !b.is_completed && (b.current_step || 1) >= 3).length,
						completed_briefs: briefs.filter(b => b.is_completed).length,
						paid_briefs: briefs.filter(b => b.is_paid).length,
						total_revenue: briefs
							.filter(b => b.is_paid)
							.reduce((sum, b) => sum + (b.amount_paid || 19900), 0)
					};
				},

				async getBriefs(page = 1, limit = 5) {
					const { data, error } = await supabase
						.from('client_briefs_steps')
						.select('*')
						.order('created_at', { ascending: false })
						.range((page - 1) * limit, page * limit - 1);
					
					if (error) throw error;
					return { data };
				}
			};

			// Vérifier l'authentification
			if (!AuthService.isAdminLoggedIn()) {
				window.location.href = '/admin/login';
			}

			// Gestion de la déconnexion
			document.getElementById('logoutBtn')?.addEventListener('click', () => {
				AuthService.logout();
				window.location.href = '/admin/login';
			});

			// Charger les statistiques
			async function loadDashboardStats() {
				try {
					const stats = await BriefService.getDashboardStats();
					
					document.getElementById('totalBriefs').textContent = stats.total_briefs.toString();
					document.getElementById('pendingBriefs').textContent = stats.pending_briefs.toString();
					document.getElementById('inProgressBriefs').textContent = stats.in_progress_briefs.toString();
					document.getElementById('totalRevenue').textContent = `${(stats.total_revenue / 100).toFixed(0)}€`;
				} catch (error) {
					console.error('Erreur lors du chargement des stats:', error);
				}
			}

			// Charger les briefs récents
			async function loadRecentBriefs() {
				try {
					const { data: briefs } = await BriefService.getBriefs(1, 5);
					const tbody = document.getElementById('recentBriefs');
					const mobileContainer = document.getElementById('recentBriefsMobile');
					
					if (!briefs || briefs.length === 0) {
						tbody.innerHTML = `
							<tr>
								<td colspan="6" class="p-8 text-center text-gray-400">
									<div class="flex flex-col items-center">
										<span class="text-4xl mb-2">📭</span>
										<p>Aucune demande pour le moment</p>
									</div>
								</td>
							</tr>
						`;
						mobileContainer.innerHTML = `
							<div class="p-4 text-center text-gray-400">
								<div class="flex flex-col items-center">
									<span class="text-4xl mb-2">📭</span>
									<p>Aucune demande pour le moment</p>
								</div>
							</div>
						`;
						return;
					}

					const statusColors = {
						pending: 'bg-yellow-100 text-yellow-800',
						in_progress: 'bg-blue-100 text-blue-800',
						completed: 'bg-green-100 text-green-800',
						cancelled: 'bg-red-100 text-red-800'
					};

					const statusLabels = {
						pending: 'En attente',
						in_progress: 'En cours',
						completed: 'Terminé',
						cancelled: 'Annulé'
					};

					// Fonction pour déterminer le statut d'un brief steps
					function getBriefStatus(brief) {
						if (brief.is_completed) return 'completed';
						if ((brief.current_step || 1) >= 3) return 'in_progress';
						return 'pending';
					}

					// Version desktop (tableau)
					tbody.innerHTML = briefs.map(brief => {
						const status = getBriefStatus(brief);
						const targetName = brief.target_first_name && brief.target_last_name 
							? `${brief.target_first_name} ${brief.target_last_name}`
							: brief.target_audience || 'Non spécifié';
						
						return `
							<tr class="hover:bg-gray-800 transition-colors">
								<td class="p-4">
									<div>
										<div class="font-medium text-white">${brief.first_name || 'N/A'} ${brief.last_name || 'N/A'}</div>
										<div class="text-sm text-gray-400">${brief.email || 'N/A'}</div>
									</div>
								</td>
								<td class="p-4">
									<div class="font-medium text-white">${brief.song_title || 'Sans titre'}</div>
									<div class="text-sm text-gray-400">Pour: ${targetName}</div>
								</td>
								<td class="p-4 text-gray-300">${brief.music_style || 'Non défini'}</td>
								<td class="p-4 text-gray-300">Étape ${brief.current_step || 1}/12</td>
								<td class="p-4">
									<div>
										<span class="px-2 py-1 text-xs rounded-full ${statusColors[status]}">
											${statusLabels[status]}
										</span>
										<div class="text-xs text-gray-500 mt-1">
											${brief.is_paid ? `Payé ${brief.amount_paid ? (brief.amount_paid / 100).toFixed(0) + '€' : ''}` : 'Non payé'}
										</div>
									</div>
								</td>
								<td class="p-4">
									<button onclick="viewBrief('${brief.id}')" 
										class="text-[#c76927] hover:text-white transition-colors text-sm">
										Voir détails
									</button>
								</td>
							</tr>
						`;
					}).join('');

					// Version mobile (cartes)
					mobileContainer.innerHTML = briefs.map(brief => {
						return `
							<div class="bg-gray-800 rounded-lg p-4">
								<div class="flex justify-between items-start mb-3">
									<div>
										<div class="font-medium text-white">${brief.first_name} ${brief.last_name}</div>
										<div class="text-sm text-gray-400">${brief.email}</div>
									</div>
									<span class="px-2 py-1 text-xs rounded-full ${statusColors[brief.status] || statusColors.pending}">
										${statusLabels[brief.status] || 'En attente'}
									</span>
								</div>
								<div class="mb-3">
									<div class="text-sm font-medium text-white">${brief.project_title || 'Sans titre'}</div>
									<div class="text-xs text-gray-400">${brief.music_style} • ${brief.project_purpose}</div>
								</div>
								<div class="flex justify-between items-center">
									<span class="text-xs text-gray-400">Délai: ${new Date(brief.deadline).toLocaleDateString('fr-FR')}</span>
									<button onclick="viewBrief('${brief.id}')" 
										class="text-[#c76927] hover:text-white transition-colors text-sm font-medium">
										Voir détails →
									</button>
								</div>
							</div>
						`;
					}).join('');

				} catch (error) {
					console.error('Erreur lors du chargement des briefs:', error);
					document.getElementById('recentBriefs').innerHTML = `
						<tr>
							<td colspan="6" class="p-8 text-center text-red-400">
								Erreur lors du chargement des données
							</td>
						</tr>
					`;
					document.getElementById('recentBriefsMobile').innerHTML = `
						<div class="p-4 text-center text-red-400">
							Erreur lors du chargement des données
						</div>
					`;
				}
			}

			// Voir les détails d'un brief
			window.viewBrief = function(briefId) {
				window.location.href = `/admin/briefs/${briefId}`;
			};

			// Afficher le nom d'utilisateur
			const session = localStorage.getItem('poppy_admin_session');
			if (session) {
				try {
					const { username } = JSON.parse(session);
					document.getElementById('adminUsername').textContent = username;
				} catch (e) {
					console.error('Erreur session:', e);
				}
			}

			// Charger les données au démarrage
			loadDashboardStats();
			loadRecentBriefs();

			// Actualiser toutes les 30 secondes
			setInterval(() => {
				loadDashboardStats();
				loadRecentBriefs();
			}, 30000);
			
			}); // Fermeture du window.addEventListener('load')
		</script>
	</body>
</html>
