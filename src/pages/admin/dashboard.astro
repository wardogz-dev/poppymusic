---
import '../../styles/global.css';

const title = "Dashboard Admin - Poppy Music";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<meta name="robots" content="noindex, nofollow" />
	</head>
	
	<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased">
		<!-- HEADER ADMIN -->
		<header class="bg-gray-900 border-b border-gray-800">
			<nav class="flex justify-between items-center px-8 py-4">
				<div class="flex items-center space-x-6">
					<h1 class="title-artistic text-2xl text-[#c76927]">Poppy Music Admin</h1>
					<div class="flex space-x-4">
						<a href="/admin/dashboard" class="text-[#c76927] border-b-2 border-[#c76927] pb-1">Dashboard</a>
						<a href="/admin/briefs" class="text-gray-400 hover:text-white transition-colors">Briefs</a>
					</div>
				</div>
				<div class="flex items-center space-x-4">
					<span class="text-sm text-gray-400">Connecté en tant que <span id="adminUsername" class="text-white">admin</span></span>
					<button id="logoutBtn" class="text-gray-400 hover:text-red-400 transition-colors">Déconnexion</button>
				</div>
			</nav>
		</header>

		<!-- MAIN CONTENT -->
		<main class="p-8">
			<div class="max-w-7xl mx-auto">
				<!-- STATISTIQUES -->
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
					<div class="bg-gray-900 rounded-lg p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium text-gray-400">Total Briefs</p>
								<p id="totalBriefs" class="text-3xl font-bold text-white">-</p>
							</div>
							<div class="w-12 h-12 bg-[#c76927] bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-[#c76927] text-xl">📝</span>
							</div>
						</div>
					</div>

					<div class="bg-gray-900 rounded-lg p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium text-gray-400">En attente</p>
								<p id="pendingBriefs" class="text-3xl font-bold text-yellow-400">-</p>
							</div>
							<div class="w-12 h-12 bg-yellow-400 bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-yellow-400 text-xl">⏳</span>
							</div>
						</div>
					</div>

					<div class="bg-gray-900 rounded-lg p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium text-gray-400">En cours</p>
								<p id="inProgressBriefs" class="text-3xl font-bold text-blue-400">-</p>
							</div>
							<div class="w-12 h-12 bg-blue-400 bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-blue-400 text-xl">🎵</span>
							</div>
						</div>
					</div>

					<div class="bg-gray-900 rounded-lg p-6">
						<div class="flex items-center justify-between">
							<div>
								<p class="text-sm font-medium text-gray-400">Revenus</p>
								<p id="totalRevenue" class="text-3xl font-bold text-green-400">-</p>
							</div>
							<div class="w-12 h-12 bg-green-400 bg-opacity-20 rounded-lg flex items-center justify-center">
								<span class="text-green-400 text-xl">💰</span>
							</div>
						</div>
					</div>
				</div>

				<!-- BRIEFS RÉCENTS -->
				<div class="bg-gray-900 rounded-lg">
					<div class="p-6 border-b border-gray-800">
						<div class="flex justify-between items-center">
							<h2 class="text-xl font-bold text-white">Demandes récentes</h2>
							<a href="/admin/briefs" class="text-[#c76927] hover:text-white transition-colors">Voir tout →</a>
						</div>
					</div>
					
					<div class="overflow-x-auto">
						<table class="w-full">
							<thead class="bg-gray-800">
								<tr>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Client</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Projet</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Style</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Délai</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Statut</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Actions</th>
								</tr>
							</thead>
							<tbody id="recentBriefs" class="divide-y divide-gray-800">
								<tr>
									<td colspan="6" class="p-8 text-center text-gray-400">
										<div class="flex flex-col items-center">
											<span class="text-4xl mb-2">🎵</span>
											<p>Chargement des demandes...</p>
										</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</main>

		<script type="module">
			import { BriefService, AuthService } from '/src/lib/supabase.ts';

			// Vérifier l'authentification
			if (!AuthService.isAdminLoggedIn()) {
				window.location.href = '/admin/login';
			}

			// Gestion de la déconnexion
			document.getElementById('logoutBtn')?.addEventListener('click', () => {
				AuthService.logout();
				window.location.href = '/admin/login';
			});

			// Charger les statistiques
			async function loadDashboardStats() {
				try {
					const stats = await BriefService.getDashboardStats();
					
					document.getElementById('totalBriefs').textContent = stats.total_briefs.toString();
					document.getElementById('pendingBriefs').textContent = stats.pending_briefs.toString();
					document.getElementById('inProgressBriefs').textContent = stats.in_progress_briefs.toString();
					document.getElementById('totalRevenue').textContent = `${(stats.total_revenue / 100).toFixed(0)}€`;
				} catch (error) {
					console.error('Erreur lors du chargement des stats:', error);
				}
			}

			// Charger les briefs récents
			async function loadRecentBriefs() {
				try {
					const { data: briefs } = await BriefService.getBriefs(1, 5);
					const tbody = document.getElementById('recentBriefs');
					
					if (!briefs || briefs.length === 0) {
						tbody.innerHTML = `
							<tr>
								<td colspan="6" class="p-8 text-center text-gray-400">
									<div class="flex flex-col items-center">
										<span class="text-4xl mb-2">📭</span>
										<p>Aucune demande pour le moment</p>
									</div>
								</td>
							</tr>
						`;
						return;
					}

					tbody.innerHTML = briefs.map(brief => {
						const statusColors = {
							pending: 'bg-yellow-100 text-yellow-800',
							in_progress: 'bg-blue-100 text-blue-800',
							completed: 'bg-green-100 text-green-800',
							cancelled: 'bg-red-100 text-red-800'
						};

						const statusLabels = {
							pending: 'En attente',
							in_progress: 'En cours',
							completed: 'Terminé',
							cancelled: 'Annulé'
						};

						return `
							<tr class="hover:bg-gray-800 transition-colors">
								<td class="p-4">
									<div>
										<div class="font-medium text-white">${brief.first_name} ${brief.last_name}</div>
										<div class="text-sm text-gray-400">${brief.email}</div>
									</div>
								</td>
								<td class="p-4">
									<div class="font-medium text-white">${brief.project_title || 'Sans titre'}</div>
									<div class="text-sm text-gray-400">${brief.project_purpose}</div>
								</td>
								<td class="p-4 text-gray-300">${brief.music_style}</td>
								<td class="p-4 text-gray-300">${new Date(brief.deadline).toLocaleDateString('fr-FR')}</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${statusColors[brief.status] || statusColors.pending}">
										${statusLabels[brief.status] || 'En attente'}
									</span>
								</td>
								<td class="p-4">
									<button onclick="viewBrief('${brief.id}')" 
										class="text-[#c76927] hover:text-white transition-colors text-sm">
										Voir détails
									</button>
								</td>
							</tr>
						`;
					}).join('');
				} catch (error) {
					console.error('Erreur lors du chargement des briefs:', error);
					document.getElementById('recentBriefs').innerHTML = `
						<tr>
							<td colspan="6" class="p-8 text-center text-red-400">
								Erreur lors du chargement des données
							</td>
						</tr>
					`;
				}
			}

			// Voir les détails d'un brief
			window.viewBrief = function(briefId) {
				window.location.href = `/admin/briefs/${briefId}`;
			};

			// Afficher le nom d'utilisateur
			const session = localStorage.getItem('poppy_admin_session');
			if (session) {
				try {
					const { username } = JSON.parse(session);
					document.getElementById('adminUsername').textContent = username;
				} catch (e) {
					console.error('Erreur session:', e);
				}
			}

			// Charger les données au démarrage
			loadDashboardStats();
			loadRecentBriefs();

			// Actualiser toutes les 30 secondes
			setInterval(() => {
				loadDashboardStats();
				loadRecentBriefs();
			}, 30000);
		</script>
	</body>
</html>
