---
import '../../styles/global.css';

export const prerender = false;

const title = "Gestion des Briefs - Poppy Music Admin";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<meta name="robots" content="noindex, nofollow" />
		<script src="https://unpkg.com/@supabase/supabase-js@2"></script>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-7XM9JLS953"></script>
		<script>
			// @ts-nocheck
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-7XM9JLS953');
		</script>
	</head>
	
	<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased">
		<!-- HEADER ADMIN -->
		<header class="bg-gray-900 border-b border-gray-800">
			<nav class="flex flex-col sm:flex-row justify-between items-start sm:items-center px-4 sm:px-8 py-4 gap-4">
				<div class="flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-6 w-full sm:w-auto">
					<h1 class="title-artistic text-xl sm:text-2xl text-[#c76927]">Poppy Music Admin</h1>
					<div class="flex space-x-4">
						<a href="/admin/dashboard" class="text-gray-400 hover:text-white transition-colors text-sm sm:text-base">Dashboard</a>
						<a href="/admin/briefs" class="text-[#c76927] border-b-2 border-[#c76927] pb-1 text-sm sm:text-base">Briefs</a>
					</div>
				</div>
				<div class="flex flex-col sm:flex-row items-start sm:items-center space-y-2 sm:space-y-0 sm:space-x-4 w-full sm:w-auto">
					<span class="text-xs sm:text-sm text-gray-400">Connecté: <span id="adminUsername" class="text-white">admin</span></span>
					<button id="logoutBtn" class="text-gray-400 hover:text-red-400 transition-colors text-sm">Déconnexion</button>
				</div>
			</nav>
		</header>

		<!-- MAIN CONTENT -->
		<main class="p-4 sm:p-8">
			<div class="max-w-7xl mx-auto">
				<!-- EN-TÊTE ET FILTRES -->
				<div class="flex flex-col gap-4 mb-6 sm:mb-8">
					<div>
						<h1 class="text-2xl sm:text-3xl font-bold text-white mb-2">Gestion des Briefs</h1>
						<p class="text-sm sm:text-base text-gray-400">Gérez toutes les demandes de création musicale</p>
					</div>
					
					<div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
						<select id="statusFilter" class="px-3 py-2 sm:px-4 sm:py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927] text-sm sm:text-base">
							<option value="">Tous les statuts</option>
							<option value="pending">En attente</option>
							<option value="in_progress">En cours</option>
							<option value="completed">Terminé</option>
							<option value="cancelled">Annulé</option>
						</select>
						
						<button id="refreshBtn" class="px-3 py-2 sm:px-4 sm:py-2 bg-[#c76927] text-black font-medium rounded-md hover:bg-[#a85520] transition-colors text-sm sm:text-base">
							Actualiser
						</button>
					</div>
				</div>

				<!-- TABLEAU DES BRIEFS -->
				<div class="bg-gray-900 rounded-lg overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full">
							<thead class="bg-gray-800">
								<tr>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Client</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Personne Ciblée</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Catégorie</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Étape</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Statut</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Paiement</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Actions</th>
								</tr>
							</thead>
							<tbody id="briefsTable" class="divide-y divide-gray-800">
							<tr>
								<td colspan="7" class="p-8 text-center text-gray-400">
										<div class="flex flex-col items-center">
											<span class="text-4xl mb-2">🔄</span>
											<p>Chargement des briefs...</p>
										</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<!-- PAGINATION -->
				<div id="pagination" class="flex justify-center items-center mt-8 space-x-4">
					<!-- Sera généré dynamiquement -->
				</div>
			</div>
		</main>

		<!-- MODAL DÉTAILS BRIEF -->
		<div id="briefModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
			<div class="bg-gray-900 rounded-lg max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto">
				<div class="p-6 border-b border-gray-800">
					<div class="flex justify-between items-center">
						<h2 class="text-2xl font-bold text-white">Détails du Brief</h2>
						<button id="closeBriefModal" class="text-gray-400 hover:text-white text-2xl">&times;</button>
					</div>
				</div>
				
				<div id="briefDetails" class="p-6">
					<!-- Contenu généré dynamiquement -->
				</div>
			</div>
		</div>

		<script>
			// @ts-nocheck
			// Attendre que Supabase soit chargé
			window.addEventListener('load', function() {
				// Configuration Supabase
				const supabase = window.supabase.createClient(
					'https://ntvnhcpkzpovqgcaiawx.supabase.co',
					'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im50dm5oY3BrenBvdnFnY2FpYXd4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTY2NTg5OTgsImV4cCI6MjA3MjIzNDk5OH0.GQfgar4VTEz3H73usQRb9Vqa3gBfOfomZgXjPlasTSw'
				);

			// Service d'authentification
			const AuthService = {
				isAdminLoggedIn() {
					const session = localStorage.getItem('poppy_admin_session');
					if (!session) return false;
					
					try {
						const { loginTime } = JSON.parse(session);
						return Date.now() - loginTime < 24 * 60 * 60 * 1000;
					} catch {
						return false;
					}
				},
				
				logout() {
					localStorage.removeItem('poppy_admin_session');
				}
			};

			// Service pour les briefs (utilise la nouvelle API)
			const BriefService = {
				async getBriefs(page = 1, limit = 20, status = '') {
					try {
						const response = await fetch(`/api/admin/briefs-steps?page=${page}&limit=${limit}&status=${status}`);
						const result = await response.json();
						
						if (result.success) {
							return { data: result.data, total: result.total };
						} else {
							throw new Error(result.message);
						}
					} catch (error) {
						console.error('Erreur BriefService:', error);
						throw error;
					}
				}
			};

			// Vérifier l'authentification
			if (!AuthService.isAdminLoggedIn()) {
				window.location.href = '/admin/login';
			}

			let currentPage = 1;
			let currentStatus = '';

			// Gestion de la déconnexion
			document.getElementById('logoutBtn')?.addEventListener('click', () => {
				AuthService.logout();
				window.location.href = '/admin/login';
			});

			// Charger les briefs
			async function loadBriefs(page = 1, status = '') {
				try {
					const { data: briefs, total } = await BriefService.getBriefs(page, 20, status);
					const tbody = document.getElementById('briefsTable');
					
					if (!briefs || briefs.length === 0) {
						tbody.innerHTML = `
							<tr>
								<td colspan="7" class="p-8 text-center text-gray-400">
									<div class="flex flex-col items-center">
										<span class="text-4xl mb-2">📭</span>
										<p>Aucun brief trouvé</p>
									</div>
								</td>
							</tr>
						`;
						return;
					}

					tbody.innerHTML = briefs.map(brief => {
						const statusColors = {
							pending: 'bg-yellow-100 text-yellow-800',
							in_progress: 'bg-blue-100 text-blue-800',
							completed: 'bg-green-100 text-green-800',
							cancelled: 'bg-red-100 text-red-800'
						};

						const paymentColors = {
							unpaid: 'bg-red-100 text-red-800',
							paid: 'bg-green-100 text-green-800',
							refunded: 'bg-gray-100 text-gray-800'
						};

						// Extraire les infos de la personne cible depuis target_audience
						const targetInfo = brief.target_audience || '';
						const targetParts = targetInfo.split(' - ');
						const targetRelation = targetParts[0] || 'Relation inconnue';
						const targetName = targetParts[1] || 'Nom inconnu';
						
						// Déterminer le statut selon l'étape
						let displayStatus = 'En cours';
						if (brief.is_completed && brief.is_paid) {
							displayStatus = 'Terminé';
						} else if (brief.is_completed && !brief.is_paid) {
							displayStatus = 'En attente paiement';
						} else {
							displayStatus = `Étape ${brief.current_step || 1}/12`;
						}
						
						return `
							<tr class="hover:bg-gray-800 transition-colors">
								<td class="p-4">
									<div>
										<div class="font-medium text-white">${brief.first_name || 'Prénom'} ${brief.last_name || 'Nom'}</div>
										<div class="text-sm text-gray-400">${brief.email || 'Email non fourni'}</div>
									</div>
								</td>
								<td class="p-4">
									<div class="font-medium text-white">${targetName}</div>
									<div class="text-sm text-gray-400">${targetRelation}</div>
								</td>
								<td class="p-4 text-gray-300">${brief.purpose_tag || 'Non définie'}</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${brief.current_step === 12 ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800'}">
										${displayStatus}
									</span>
								</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${brief.is_completed ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'}">
										${brief.is_completed ? 'Terminé' : 'En cours'}
									</span>
								</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${brief.is_paid ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
										${brief.is_paid ? 'Payé' : 'Non payé'}
									</span>
								</td>
								<td class="p-4">
									<div class="flex space-x-2">
										<button onclick="viewBrief('${brief.id}')" 
											class="text-[#c76927] hover:text-white transition-colors text-sm">
											Voir
										</button>
									</div>
								</td>
							</tr>
						`;
					}).join('');

					// Générer la pagination
					generatePagination(page, Math.ceil(total / 20));
				} catch (error) {
					console.error('Erreur:', error);
				}
			}

			// Générer la pagination
			function generatePagination(current, totalPages) {
				const pagination = document.getElementById('pagination');
				if (totalPages <= 1) {
					pagination.innerHTML = '';
					return;
				}

				let html = '';
				
				// Bouton précédent
				if (current > 1) {
					html += `<button onclick="changePage(${current - 1})" class="px-3 py-2 bg-gray-800 text-white rounded-md hover:bg-gray-700">Précédent</button>`;
				}

				// Numéros de page
				for (let i = Math.max(1, current - 2); i <= Math.min(totalPages, current + 2); i++) {
					html += `<button onclick="changePage(${i})" class="px-3 py-2 ${i === current ? 'bg-[#c76927] text-black' : 'bg-gray-800 text-white hover:bg-gray-700'} rounded-md">${i}</button>`;
				}

				// Bouton suivant
				if (current < totalPages) {
					html += `<button onclick="changePage(${current + 1})" class="px-3 py-2 bg-gray-800 text-white rounded-md hover:bg-gray-700">Suivant</button>`;
				}

				pagination.innerHTML = html;
			}

			// Changer de page
			window.changePage = function(page) {
				currentPage = page;
				loadBriefs(page, currentStatus);
			};

			// Voir les détails d'un brief
			window.viewBrief = function(briefId) {
				window.location.href = `/admin/brief-detail?id=${briefId}`;
			};

			// Modifier un brief
			window.editBrief = function(briefId) {
				// TODO: Ouvrir le modal d'édition
				console.log('Modifier brief:', briefId);
			};

			// Filtres
			document.getElementById('statusFilter')?.addEventListener('change', function(e) {
				currentStatus = (e.target as HTMLSelectElement).value;
				currentPage = 1;
				loadBriefs(1, currentStatus);
			});

			// Actualiser
			document.getElementById('refreshBtn')?.addEventListener('click', () => {
				loadBriefs(currentPage, currentStatus);
			});

			// Afficher le nom d'utilisateur
			const session = localStorage.getItem('poppy_admin_session');
			if (session) {
				try {
					const { username } = JSON.parse(session);
					document.getElementById('adminUsername').textContent = username;
				} catch (e) {
					console.error('Erreur session:', e);
				}
			}

			// Charger les briefs au démarrage
			loadBriefs();
			
			}); // Fermeture du window.addEventListener('load')
		</script>
	</body>
</html>
