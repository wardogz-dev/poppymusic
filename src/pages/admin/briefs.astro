---
import '../../styles/global.css';

const title = "Gestion des Briefs - Poppy Music Admin";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<meta name="robots" content="noindex, nofollow" />
	</head>
	
	<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased">
		<!-- HEADER ADMIN -->
		<header class="bg-gray-900 border-b border-gray-800">
			<nav class="flex justify-between items-center px-8 py-4">
				<div class="flex items-center space-x-6">
					<h1 class="title-artistic text-2xl text-[#c76927]">Poppy Music Admin</h1>
					<div class="flex space-x-4">
						<a href="/admin/dashboard" class="text-gray-400 hover:text-white transition-colors">Dashboard</a>
						<a href="/admin/briefs" class="text-[#c76927] border-b-2 border-[#c76927] pb-1">Briefs</a>
					</div>
				</div>
				<div class="flex items-center space-x-4">
					<span class="text-sm text-gray-400">Connecté en tant que <span id="adminUsername" class="text-white">admin</span></span>
					<button id="logoutBtn" class="text-gray-400 hover:text-red-400 transition-colors">Déconnexion</button>
				</div>
			</nav>
		</header>

		<!-- MAIN CONTENT -->
		<main class="p-8">
			<div class="max-w-7xl mx-auto">
				<!-- EN-TÊTE ET FILTRES -->
				<div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-8">
					<div>
						<h1 class="text-3xl font-bold text-white mb-2">Gestion des Briefs</h1>
						<p class="text-gray-400">Gérez toutes les demandes de création musicale</p>
					</div>
					
					<div class="flex flex-col sm:flex-row gap-4 mt-4 lg:mt-0">
						<select id="statusFilter" class="px-4 py-2 bg-gray-800 border border-gray-700 rounded-md text-white focus:ring-2 focus:ring-[#c76927]">
							<option value="">Tous les statuts</option>
							<option value="pending">En attente</option>
							<option value="in_progress">En cours</option>
							<option value="completed">Terminé</option>
							<option value="cancelled">Annulé</option>
						</select>
						
						<button id="refreshBtn" class="px-4 py-2 bg-[#c76927] text-black font-medium rounded-md hover:bg-[#a85520] transition-colors">
							Actualiser
						</button>
					</div>
				</div>

				<!-- TABLEAU DES BRIEFS -->
				<div class="bg-gray-900 rounded-lg overflow-hidden">
					<div class="overflow-x-auto">
						<table class="w-full">
							<thead class="bg-gray-800">
								<tr>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Client</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Projet</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Style</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Formule</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Délai</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Statut</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Paiement</th>
									<th class="text-left p-4 text-sm font-medium text-gray-300">Actions</th>
								</tr>
							</thead>
							<tbody id="briefsTable" class="divide-y divide-gray-800">
								<tr>
									<td colspan="8" class="p-8 text-center text-gray-400">
										<div class="flex flex-col items-center">
											<span class="text-4xl mb-2">🔄</span>
											<p>Chargement des briefs...</p>
										</div>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<!-- PAGINATION -->
				<div id="pagination" class="flex justify-center items-center mt-8 space-x-4">
					<!-- Sera généré dynamiquement -->
				</div>
			</div>
		</main>

		<!-- MODAL DÉTAILS BRIEF -->
		<div id="briefModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
			<div class="bg-gray-900 rounded-lg max-w-4xl w-full mx-4 max-h-[90vh] overflow-y-auto">
				<div class="p-6 border-b border-gray-800">
					<div class="flex justify-between items-center">
						<h2 class="text-2xl font-bold text-white">Détails du Brief</h2>
						<button id="closeBriefModal" class="text-gray-400 hover:text-white text-2xl">&times;</button>
					</div>
				</div>
				
				<div id="briefDetails" class="p-6">
					<!-- Contenu généré dynamiquement -->
				</div>
			</div>
		</div>

		<script type="module">
			import { BriefService, AuthService } from '/src/lib/supabase.ts';

			// Vérifier l'authentification
			if (!AuthService.isAdminLoggedIn()) {
				window.location.href = '/admin/login';
			}

			let currentPage = 1;
			let currentStatus = '';

			// Gestion de la déconnexion
			document.getElementById('logoutBtn')?.addEventListener('click', () => {
				AuthService.logout();
				window.location.href = '/admin/login';
			});

			// Charger les briefs
			async function loadBriefs(page = 1, status = '') {
				try {
					const { data: briefs, total } = await BriefService.getBriefs(page, 20, status);
					const tbody = document.getElementById('briefsTable');
					
					if (!briefs || briefs.length === 0) {
						tbody.innerHTML = `
							<tr>
								<td colspan="8" class="p-8 text-center text-gray-400">
									<div class="flex flex-col items-center">
										<span class="text-4xl mb-2">📭</span>
										<p>Aucun brief trouvé</p>
									</div>
								</td>
							</tr>
						`;
						return;
					}

					tbody.innerHTML = briefs.map(brief => {
						const statusColors = {
							pending: 'bg-yellow-100 text-yellow-800',
							in_progress: 'bg-blue-100 text-blue-800',
							completed: 'bg-green-100 text-green-800',
							cancelled: 'bg-red-100 text-red-800'
						};

						const paymentColors = {
							unpaid: 'bg-red-100 text-red-800',
							paid: 'bg-green-100 text-green-800',
							refunded: 'bg-gray-100 text-gray-800'
						};

						return `
							<tr class="hover:bg-gray-800 transition-colors">
								<td class="p-4">
									<div>
										<div class="font-medium text-white">${brief.first_name} ${brief.last_name}</div>
										<div class="text-sm text-gray-400">${brief.email}</div>
									</div>
								</td>
								<td class="p-4">
									<div class="font-medium text-white">${brief.project_title || 'Sans titre'}</div>
									<div class="text-sm text-gray-400">${brief.project_purpose}</div>
								</td>
								<td class="p-4 text-gray-300">${brief.music_style}</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${brief.package === 'premium' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}">
										${brief.package === 'premium' ? 'Premium (399€)' : 'Standard (199€)'}
									</span>
								</td>
								<td class="p-4 text-gray-300">${new Date(brief.deadline).toLocaleDateString('fr-FR')}</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${statusColors[brief.status] || statusColors.pending}">
										${brief.status || 'pending'}
									</span>
								</td>
								<td class="p-4">
									<span class="px-2 py-1 text-xs rounded-full ${paymentColors[brief.payment_status] || paymentColors.unpaid}">
										${brief.payment_status || 'unpaid'}
									</span>
								</td>
								<td class="p-4">
									<div class="flex space-x-2">
										<button onclick="viewBrief('${brief.id}')" 
											class="text-[#c76927] hover:text-white transition-colors text-sm">
											Voir
										</button>
										<button onclick="editBrief('${brief.id}')" 
											class="text-blue-400 hover:text-white transition-colors text-sm">
											Modifier
										</button>
									</div>
								</td>
							</tr>
						`;
					}).join('');

					// Générer la pagination
					generatePagination(page, Math.ceil(total / 20));
				} catch (error) {
					console.error('Erreur:', error);
				}
			}

			// Générer la pagination
			function generatePagination(current, totalPages) {
				const pagination = document.getElementById('pagination');
				if (totalPages <= 1) {
					pagination.innerHTML = '';
					return;
				}

				let html = '';
				
				// Bouton précédent
				if (current > 1) {
					html += `<button onclick="changePage(${current - 1})" class="px-3 py-2 bg-gray-800 text-white rounded-md hover:bg-gray-700">Précédent</button>`;
				}

				// Numéros de page
				for (let i = Math.max(1, current - 2); i <= Math.min(totalPages, current + 2); i++) {
					html += `<button onclick="changePage(${i})" class="px-3 py-2 ${i === current ? 'bg-[#c76927] text-black' : 'bg-gray-800 text-white hover:bg-gray-700'} rounded-md">${i}</button>`;
				}

				// Bouton suivant
				if (current < totalPages) {
					html += `<button onclick="changePage(${current + 1})" class="px-3 py-2 bg-gray-800 text-white rounded-md hover:bg-gray-700">Suivant</button>`;
				}

				pagination.innerHTML = html;
			}

			// Changer de page
			window.changePage = function(page) {
				currentPage = page;
				loadBriefs(page, currentStatus);
			};

			// Voir les détails d'un brief
			window.viewBrief = function(briefId) {
				// TODO: Charger et afficher les détails dans le modal
				console.log('Voir brief:', briefId);
			};

			// Modifier un brief
			window.editBrief = function(briefId) {
				// TODO: Ouvrir le modal d'édition
				console.log('Modifier brief:', briefId);
			};

			// Filtres
			document.getElementById('statusFilter')?.addEventListener('change', function(e) {
				currentStatus = (e.target as HTMLSelectElement).value;
				currentPage = 1;
				loadBriefs(1, currentStatus);
			});

			// Actualiser
			document.getElementById('refreshBtn')?.addEventListener('click', () => {
				loadBriefs(currentPage, currentStatus);
			});

			// Afficher le nom d'utilisateur
			const session = localStorage.getItem('poppy_admin_session');
			if (session) {
				try {
					const { username } = JSON.parse(session);
					document.getElementById('adminUsername').textContent = username;
				} catch (e) {
					console.error('Erreur session:', e);
				}
			}

			// Charger les briefs au démarrage
			loadBriefs();
		</script>
	</body>
</html>
