---
import '../styles/global.css';
import UseCases from '../components/UseCases.astro';
import ProductionsGrid from '../components/ProductionsGrid.astro';

const BRAND_NAME = "Poppy Music";
const TAGLINE = "Votre message en musique";

// Open Graph metadata
const title = "Poppy Music — crée ta chanson sur-mesure";
const description = "Fais passer un message en musique. Crée ta chanson personnalisée et unique.";
const image = "https://poppymusic.fr/og-image.png?v=3"; // versionne pour casser le cache
const url = "https://poppymusic.fr/";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- Favicon -->
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
	</head>
<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased overflow-x-hidden">
	
	<!-- HEADER AVEC NAVIGATION -->
	<header class="fixed top-0 left-0 right-0 z-50 glass-effect">
		<nav class="flex justify-between items-center px-4 sm:px-8 py-4 sm:py-6">
			<div class="title-artistic text-xl sm:text-2xl text-[#c76927]">{BRAND_NAME}</div>
			
			<!-- Navigation Desktop -->
			<div class="hidden md:flex items-center space-x-8">
				<a href="#productions" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">Productions</a>
				<a href="#faq" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">FAQ</a>
				<a href="/brief" class="bg-[#c76927] text-black px-6 py-2 text-sm font-medium rounded-md hover:bg-[#a85520] transition-all">
					Créer ma chanson
				</a>
			</div>

			<!-- Navigation Mobile -->
			<div class="md:hidden flex items-center space-x-4">
				<div class="text-artistic text-xs text-gray-400 uppercase tracking-wider">{TAGLINE}</div>
				<button id="mobileMenuBtn" class="text-gray-300 hover:text-[#c76927] transition-colors">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
		</nav>

		<!-- Menu Mobile (caché par défaut) -->
		<div id="mobileMenu" class="md:hidden hidden bg-gray-900 bg-opacity-95 backdrop-blur-sm border-t border-gray-800">
			<div class="px-4 py-6 space-y-4">
				<a href="#productions" class="block text-gray-300 hover:text-[#c76927] transition-colors text-base font-medium py-2" onclick="closeMobileMenu()">
					Productions
				</a>
				<a href="#faq" class="block text-gray-300 hover:text-[#c76927] transition-colors text-base font-medium py-2" onclick="closeMobileMenu()">
					FAQ
				</a>
				<a href="/brief" class="block bg-[#c76927] text-black px-6 py-3 text-base font-medium rounded-md hover:bg-[#a85520] transition-all text-center" onclick="closeMobileMenu()">
					Créer ma chanson
				</a>
			</div>
		</div>
	</header>

	<!-- HERO SECTION -->
	<section class="min-h-screen flex items-center justify-center noise-texture relative overflow-hidden">
		<div class="absolute inset-0 hero-bg"></div>
		<div class="relative z-10 text-center max-w-4xl mx-auto px-6">
			<h1 class="title-artistic text-6xl md:text-8xl lg:text-9xl text-white mb-8 leading-none">
				Devenez<br/>
				<span class="text-[#c76927]">Producteur</span>
			</h1>
			<p class="text-artistic text-xl md:text-2xl text-gray-300 max-w-2xl mx-auto mb-12 leading-relaxed">
				Produisez votre chanson avec notre studio.<br/>
				Votre histoire, votre message, votre signature sonore.
			</p>
			<div class="flex flex-col md:flex-row gap-6 justify-center items-center">
				<a href="/brief" class="bg-[#c76927] text-black px-12 py-4 text-lg font-medium tracking-wide hover:bg-[#a85520] transition-all duration-300 hover:scale-105 rounded-md inline-block text-center">
					PRODUIRE VOTRE CHANSON
				</a>
				<a href="#productions" class="border border-[#c76927] text-[#c76927] px-12 py-4 text-lg font-medium tracking-wide hover:bg-[#c76927] hover:text-black transition-all duration-300 rounded-md inline-block text-center">
					DÉCOUVRIR NOS PRODUCTIONS
				</a>
			</div>

			<!-- CITATION -->
			<div class="mt-20 max-w-4xl mx-auto">
				<blockquote class="text-center">
					<p class="text-xl md:text-2xl lg:text-3xl italic text-gray-300 leading-relaxed mb-6 font-serif">
						« Là où les mots échouent, la musique parle. »
					</p>
					<cite class="text-base md:text-lg text-gray-500 not-italic">
						— Hans Christian Andersen, écrivain danois (1805–1875)
					</cite>
				</blockquote>
			</div>
		</div>
	</section>

	<!-- QUI NOUS SOMMES -->
	<section class="py-32 px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div>
					<h2 class="title-artistic text-5xl md:text-6xl text-white mb-8 leading-tight">
						Qui sommes<br/>
						<span class="text-[#c76927]">nous</span>
					</h2>
					<div class="text-artistic text-lg text-gray-300 space-y-6">
						<p>
							Poppy Music est un studio de production musicale où l'intelligence artificielle 
							rencontre l'intuition humaine. Nous transformons vos idées en œuvres musicales 
							authentiques et professionnelles.
						</p>
						<p>
							Notre approche hybride vous place au centre du processus créatif. 
							Vous devenez le producteur de votre chanson, avec votre nom dans les crédits 
							et vos droits sur l'œuvre finale.
						</p>
						<p>
							Chaque projet est une collaboration entre vous, nos compositeurs, nos ingénieurs du son 
							et notre technologie propriétaire d'IA musicale.
						</p>
					</div>
				</div>
				<div class="relative">
					<div class="album-container mx-auto" style="width: 400px; height: 250px;">
						<div class="album-cover">
							<div class="album-cover-closed">
								<img src="/images/covers/poppy-music-closed.png" alt="Album fermé" class="w-full h-full object-cover" />
							</div>
							<div class="album-cover-opened">
								<img src="/images/covers/poppy-music-opened.png" alt="Album ouvert avec vinyle" class="w-full h-full object-cover" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- PRODUCTIONS -->
	<section id="productions" class="py-32 px-6 bg-gradient-to-b from-[#0B0B0B] to-[#121212]">
		<div class="max-w-7xl mx-auto">
			<h2 class="title-artistic text-5xl md:text-6xl text-white text-center mb-4">
				Nos <span class="text-[#c76927]">Productions</span>
			</h2>
			<p class="text-artistic text-lg text-gray-400 text-center mb-8 max-w-3xl mx-auto">
				Découvrez les créations de nos producteurs. Chaque chanson raconte une histoire, 
				porte un message, exprime une émotion unique.
			</p>
			
			<!-- Tags explicatifs -->
			<div class="flex flex-wrap justify-center gap-4 mb-20">
				<div class="flex items-center gap-2">
					<span class="w-3 h-3 bg-purple-500 rounded-full"></span>
					<span class="text-gray-400 text-sm">Anniversaire Adulte</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="w-3 h-3 bg-pink-500 rounded-full"></span>
					<span class="text-gray-400 text-sm">Anniversaire Enfant</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="w-3 h-3 bg-blue-500 rounded-full"></span>
					<span class="text-gray-400 text-sm">Entreprise</span>
				</div>
				<div class="flex items-center gap-2">
					<span class="w-3 h-3 bg-green-500 rounded-full"></span>
					<span class="text-gray-400 text-sm">Association</span>
				</div>
			</div>

			<ProductionsGrid />
		</div>
	</section>

	<!-- SERVICES CRÉATIFS -->
	<section class="py-32 px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
				<div>
					<h2 class="title-artistic text-5xl md:text-6xl text-white mb-8 leading-tight">
						Votre Projet<br/>
						<span class="text-[#c76927]">Musical</span>
					</h2>
					<div class="text-artistic text-lg text-gray-300 space-y-6 mb-12">
						<p>
							<strong>Vous devenez le producteur</strong> de votre propre chanson. Nous vous accompagnons 
							de l'idée initiale jusqu'à la diffusion sur toutes les plateformes mondiales.
						</p>
						<p>
							Que ce soit pour porter un message, célébrer un moment, ou créer votre signature sonore, 
							<strong>votre nom apparaîtra dans les crédits</strong> comme producteur de l'œuvre.
						</p>
					</div>
					
					<div class="space-y-8">
						<div class="flex items-start gap-6">
							<div class="w-12 h-12 bg-[#c76927] flex items-center justify-center text-black font-bold text-lg">01</div>
							<div>
								<h3 class="text-white font-semibold text-xl mb-2">Brief de Production</h3>
								<p class="text-gray-400">Votre message, votre style, l'émotion que vous voulez transmettre</p>
							</div>
						</div>
						<div class="flex items-start gap-6">
							<div class="w-12 h-12 bg-[#c76927] flex items-center justify-center text-black font-bold text-lg">02</div>
							<div>
								<h3 class="text-white font-semibold text-xl mb-2">Pre-Production</h3>
								<p class="text-gray-400">Exploration créative, maquettes et direction artistique</p>
							</div>
						</div>
						<div class="flex items-start gap-6">
							<div class="w-12 h-12 bg-[#c76927] flex items-center justify-center text-black font-bold text-lg">03</div>
							<div>
								<h3 class="text-white font-semibold text-xl mb-2">Production Studio</h3>
								<p class="text-gray-400">Enregistrement, composition, mix et mastering professionnel</p>
							</div>
						</div>
					</div>

					<div class="mt-12">
						<a href="/brief" class="bg-[#c76927] text-black px-12 py-4 text-lg font-medium tracking-wide hover:bg-[#a85520] transition-all duration-300 rounded-md inline-block text-center">
							CRÉER VOTRE CHANSON
						</a>
					</div>
				</div>
				
				<div class="glass-effect p-12 rounded-lg">
					<h3 class="title-artistic text-3xl text-white mb-8">Pack Production</h3>
					<div class="space-y-6">
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Ton Brief Producteur</h4>
							<p class="text-gray-400 text-sm">Définis ton message, ton style, l'émotion que tu veux transmettre</p>
						</div>
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Pre-Production</h4>
							<p class="text-gray-400 text-sm">Exploration créative, maquettes et direction artistique</p>
						</div>
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Production Studio</h4>
							<p class="text-gray-400 text-sm">Enregistrement, composition, mix et mastering professionnel</p>
						</div>
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Post-Production</h4>
							<p class="text-gray-400 text-sm">Finalisation, crédits producteur et distribution mondiale</p>
						</div>
					</div>
					
					<div class="mt-8 p-4 bg-black bg-opacity-30 rounded-lg">
						<p class="text-[#c76927] font-semibold mb-1">Inclus dans ton Pack Production :</p>
						<p class="text-gray-300 text-sm">Chanson finale • Instrumental • Paroles • Crédits producteur • Distribution streaming</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CAS D'USAGE ÉLARGIS -->
	<UseCases />

	<!-- PLAYLIST SPOTIFY -->
	<section class="py-20 px-6 bg-gradient-to-b from-[#0B0B0B] to-[#121212]">
		<div class="max-w-4xl mx-auto text-center">
			<h2 class="title-artistic text-4xl md:text-5xl text-white mb-6">
				Écoutez nos <span class="text-[#c76927]">Créations</span>
			</h2>
			<p class="text-xl text-gray-300 mb-12">
				Découvrez nos productions sur Spotify
			</p>
			
			<div class="bg-gray-900 bg-opacity-50 rounded-lg p-8">
				<iframe data-testid="embed-iframe" style="border-radius:12px" src="https://open.spotify.com/embed/playlist/2utrwtRZQ190B4uWxOfzk8?utm_source=generator&theme=0" width="100%" height="352" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
			</div>
		</div>
	</section>

	<!-- CONTACT -->
	<section class="py-32 px-6 bg-gradient-to-t from-[#0B0B0B] to-[#121212]">
		<div class="max-w-4xl mx-auto text-center">
			<h2 class="title-artistic text-5xl md:text-6xl text-white mb-8">
				Créons Ensemble
			</h2>
			<p class="text-artistic text-xl text-gray-300 mb-12 max-w-2xl mx-auto">
				Prêt à explorer de nouveaux territoires sonores ?<br/>
				Contactez-nous pour discuter de votre projet.
			</p>
			
			<div class="flex flex-col md:flex-row gap-8 justify-center items-center mb-16">
				<a href="mailto:hello@poppymusic.com" class="bg-[#c76927] text-black px-12 py-4 text-lg font-medium tracking-wide hover:bg-[#a85520] transition-all duration-300 rounded-md inline-block text-center">
					HELLO@POPPYMUSIC.COM
				</a>
				<div class="text-gray-400 text-lg">ou</div>
				<button class="border border-[#c76927] text-[#c76927] px-12 py-4 text-lg font-medium tracking-wide hover:bg-[#c76927] hover:text-black transition-all duration-300 rounded-md">
					FORMULAIRE DE CONTACT
				</button>
			</div>
			
			<div class="flex justify-center gap-12 text-gray-400">
				<a href="#" class="hover:text-[#c76927] transition-colors">Instagram</a>
				<a href="#" class="hover:text-[#c76927] transition-colors">Spotify</a>
				<a href="#" class="hover:text-[#c76927] transition-colors">SoundCloud</a>
				<a href="#" class="hover:text-[#c76927] transition-colors">Bandcamp</a>
			</div>
		</div>
	</section>

	<!-- FAQ SECTION -->
	<section id="faq" class="py-20 px-6 bg-gradient-to-b from-[#121212] to-[#0B0B0B]">
		<div class="max-w-4xl mx-auto">
			<div class="text-center mb-16">
				<h2 class="title-artistic text-4xl md:text-5xl text-white mb-6">
					🎵 Foire aux <span class="text-[#c76927]">Questions</span>
				</h2>
				<p class="text-xl text-gray-300">
					Tout ce que vous devez savoir sur nos services
				</p>
			</div>

			<div class="space-y-6">
				<!-- Question 1 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq1">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
								<span class="text-2xl mr-3">💡</span>
								Qu'est-ce que PoppyMusic ?
							</h3>
							<span class="faq-icon text-[#c76927] text-xl transition-transform">+</span>
						</div>
					</button>
					<div id="faq1" class="faq-content hidden p-6 pt-0 border-t border-gray-800">
						<p class="text-gray-300 leading-relaxed">
							PoppyMusic est un studio créatif qui vous permet de produire une chanson sur-mesure, même si vous n'êtes pas musicien.ne. Que ce soit pour un anniversaire, un mariage, un message personnel ou une cause à défendre, vous nous partagez votre idée, et nous la transformons en chanson.
						</p>
					</div>
				</div>

				<!-- Question 2 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq2">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
								<span class="text-2xl mr-3">🧑‍🎤</span>
								Qui chante et compose la chanson ?
							</h3>
							<span class="faq-icon text-[#c76927] text-xl transition-transform">+</span>
						</div>
					</button>
					<div id="faq2" class="faq-content hidden p-6 pt-0 border-t border-gray-800">
						<p class="text-gray-300 leading-relaxed">
							Nous travaillons avec un collectif de compositeurs et d'interprètes professionnels. En fonction de votre projet, nous sélectionnons la voix, le style et les arrangements qui correspondent le mieux à votre univers.
						</p>
					</div>
				</div>

				<!-- Question 3 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq3">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
								<span class="text-2xl mr-3">✍️</span>
								Je ne sais pas écrire de texte, est-ce un problème ?
							</h3>
							<span class="faq-icon text-[#c76927] text-xl transition-transform">+</span>
						</div>
					</button>
					<div id="faq3" class="faq-content hidden p-6 pt-0 border-t border-gray-800">
						<p class="text-gray-300 leading-relaxed">
							Pas du tout. Vous nous racontez votre histoire, vos souvenirs ou le message que vous souhaitez transmettre, et notre équipe s'occupe d'écrire les paroles à partir de vos mots. Vous pouvez bien sûr valider les paroles avant qu'elles soient enregistrées.
						</p>
					</div>
				</div>

				<!-- Question 4 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq4">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
								<span class="text-2xl mr-3">📦</span>
								Que vais-je recevoir ?
							</h3>
							<span class="faq-icon text-[#c76927] text-xl transition-transform">+</span>
						</div>
					</button>
					<div id="faq4" class="faq-content hidden p-6 pt-0 border-t border-gray-800">
						<div class="text-gray-300 leading-relaxed">
							<ul class="space-y-2">
								<li>• Une chanson originale livrée en MP3</li>
								<li>• Une cover visuelle professionnelle</li>
								<li>• En option : un vinyle personnalisé, un disque d'or encadré, ou même un clip animé si vous le souhaitez</li>
							</ul>
						</div>
					</div>
				</div>

				<!-- Question 5 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq5">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
								<span class="text-2xl mr-3">🎧</span>
								La chanson est-elle produite de manière professionnelle ?
							</h3>
							<span class="faq-icon text-[#c76927] text-xl transition-transform">+</span>
						</div>
					</button>
					<div id="faq5" class="faq-content hidden p-6 pt-0 border-t border-gray-800">
						<p class="text-gray-300 leading-relaxed">
							Oui. Chaque morceau est produit en studio avec les mêmes standards que les artistes que vous écoutez : composition, enregistrement, mixage, mastering, tout est fait dans les règles de l'art.
						</p>
					</div>
				</div>

				<!-- Question 6 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq6">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
								<span class="text-2xl mr-3">⏳</span>
								Quels sont les délais de livraison ?
							</h3>
							<span class="faq-icon text-[#c76927] text-xl transition-transform">+</span>
						</div>
					</button>
					<div id="faq6" class="faq-content hidden p-6 pt-0 border-t border-gray-800">
						<p class="text-gray-300 leading-relaxed">
							La majorité des projets sont livrés sous 7 à 10 jours ouvrés. Si votre demande est urgente (ex. cadeau de dernière minute), nous proposons également une option express.
						</p>
					</div>
				</div>

				<!-- Question 7 -->
				<div class="bg-gray-900 bg-opacity-50 rounded-lg overflow-hidden">
					<button class="faq-trigger w-full text-left p-6 hover:bg-gray-800 transition-colors" data-target="faq7">
						<div class="flex justify-between items-center">
							<h3 class="text-lg font-semibold text-white flex items-center">
