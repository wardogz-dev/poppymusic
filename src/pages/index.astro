---
import '../styles/global.css';
import UseCases from '../components/UseCases.astro';
import ProductionsGrid from '../components/ProductionsGrid.astro';

const BRAND_NAME = "Poppy Music";
const TAGLINE = "Votre message en musique";

// Open Graph metadata
const title = "Poppy Music Studio | Création de Chansons Personnalisées | Votre Message en Musique";
const description = "Studio de production musicale spécialisé dans la création de chansons personnalisées. Transformez votre histoire en chanson unique avec nos compositeurs professionnels. Livraison 7-10 jours.";
const image = "https://poppymusic.fr/og-image.png?v=3"; // versionne pour casser le cache
const url = "https://poppymusic.fr/";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<!-- Favicon et icônes -->
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<link rel="alternate icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/icon-2025.svg" />
		<link rel="shortcut icon" href="/icon-2025.svg" />

		<!-- Open Graph -->
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Google Tag Manager -->
		<script is:inline>
		(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-NGZ6SCTP');
		</script>
		<!-- End Google Tag Manager -->

	<!-- Twitter -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={image} />

	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-7XM9JLS953"></script>
	<script>
		// @ts-nocheck
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());

		gtag('config', 'G-7XM9JLS953');
	</script>
	</head>
<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased overflow-x-hidden">
	<!-- Google Tag Manager (noscript) -->
	<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NGZ6SCTP"
	height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	<!-- End Google Tag Manager (noscript) -->
	
	<!-- HEADER AVEC NAVIGATION -->
	<header class="fixed top-0 left-0 right-0 z-50 glass-effect">
		<nav class="flex justify-between items-center px-4 sm:px-8 py-2 sm:py-6">
			<div class="title-artistic text-lg sm:text-2xl text-[#c76927]">{BRAND_NAME}</div>
			
			<!-- Navigation Desktop -->
			<div class="hidden lg:flex items-center space-x-6">
				<a href="#productions" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">Productions</a>
				<a href="#about" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">À propos</a>
				<a href="#pricing" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">Tarifs</a>
				<a href="#spotify" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">Spotify</a>
				<a href="#faq" class="text-gray-300 hover:text-[#c76927] transition-colors text-sm font-medium">FAQ</a>
				<a href="/brief-new" class="bg-[#c76927] text-black px-6 py-2 text-sm font-medium rounded-md hover:bg-[#a85520] transition-all">
					Créer ma chanson
				</a>
			</div>

			<!-- Navigation Mobile -->
			<div class="md:hidden flex items-center">
				<button id="mobileMenuBtn" class="text-gray-300 hover:text-[#c76927] transition-colors">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
		</nav>

		<!-- Menu Mobile (caché par défaut) -->
		<div id="mobileMenu" class="md:hidden hidden bg-gray-900 bg-opacity-95 backdrop-blur-sm border-t border-gray-800">
			<div class="px-4 py-6 space-y-4">
				<a href="#productions" class="block text-gray-300 hover:text-[#c76927] transition-colors text-base font-medium py-2" onclick="closeMobileMenu()">
					Productions
				</a>
				<a href="#about" class="block text-gray-300 hover:text-[#c76927] transition-colors text-base font-medium py-2" onclick="closeMobileMenu()">
					À propos
				</a>
				<a href="#spotify" class="block text-gray-300 hover:text-[#c76927] transition-colors text-base font-medium py-2" onclick="closeMobileMenu()">
					Spotify
				</a>
				<a href="#faq" class="block text-gray-300 hover:text-[#c76927] transition-colors text-base font-medium py-2" onclick="closeMobileMenu()">
					FAQ
				</a>
				<a href="/brief-new" class="block bg-[#c76927] text-black px-6 py-3 text-base font-medium rounded-md hover:bg-[#a85520] transition-all text-center" onclick="closeMobileMenu()">
					Créer ma chanson
				</a>
			</div>
		</div>
	</header>

	<!-- HERO SECTION -->
	<section class="min-h-screen flex items-center justify-center noise-texture relative overflow-hidden pt-24 sm:pt-20">
		<div class="absolute inset-0 hero-bg"></div>
		<div class="relative z-10 text-center max-w-5xl mx-auto px-4 sm:px-6">
			<h1 class="title-artistic text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl text-white mb-6 sm:mb-8 leading-tight sm:leading-none">
				Transformez une histoire<br/>
				en <span class="text-[#c76927]">chanson</span>
			</h1>
			<div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center">
				<a href="/brief-new" class="bg-[#c76927] text-black px-8 sm:px-12 py-3 sm:py-4 text-base sm:text-lg font-medium tracking-wide hover:bg-[#a85520] transition-all duration-300 hover:scale-105 rounded-md inline-block text-center w-full sm:w-auto max-w-xs sm:max-w-none min-h-[4rem] sm:min-h-[5rem] flex flex-col justify-center">
					CRÉER MA CHANSON
					<span class="block text-xs opacity-80 mt-1">199€ - Production complète</span>
				</a>
				<a href="#productions" class="border border-[#c76927] text-[#c76927] px-8 sm:px-12 py-3 sm:py-4 text-base sm:text-lg font-medium tracking-wide hover:bg-[#c76927] hover:text-black transition-all duration-300 rounded-md inline-block text-center w-full sm:w-auto max-w-xs sm:max-w-none min-h-[4rem] sm:min-h-[5rem] flex items-center justify-center">
					DÉCOUVRIR NOS PRODUCTIONS
				</a>
			</div>

			<!-- CITATION -->
			<div class="mt-12 sm:mt-16 md:mt-20 max-w-4xl mx-auto">
				<blockquote class="text-center">
					<p class="text-lg sm:text-xl md:text-2xl lg:text-3xl italic text-gray-300 leading-relaxed mb-4 sm:mb-6 font-serif px-4">
						« Là où les mots échouent, la musique parle. »
					</p>
					<cite class="text-sm sm:text-base md:text-lg text-gray-500 not-italic px-4">
						— Hans Christian Andersen, écrivain danois (1805–1875)
					</cite>
				</blockquote>
			</div>
		</div>
	</section>

	<!-- QUI NOUS SOMMES -->
	<section id="about" class="py-32 px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div>
					<h2 class="title-artistic text-5xl md:text-6xl text-white mb-8 leading-tight">
						Qui<br/>
						<span class="text-[#c76927]">sommes-nous ?</span>
					</h2>
					<div class="text-artistic text-lg text-gray-300 space-y-6">
						<p>
							Poppy Music est un studio de production musicale où l'intelligence artificielle 
							rencontre l'intuition humaine. Nous transformons vos idées en œuvres musicales 
							authentiques et professionnelles.
						</p>
						<p>
							Notre approche hybride vous place au centre du processus créatif. 
							Vous devenez le co-producteur de votre chanson personnalisée. 
							Nous gardons les droits d'auteur, vous obtenez un usage personnel illimité.
						</p>
						<p>
							Chaque projet est une collaboration entre vous, nos compositeurs, nos ingénieurs du son 
							et notre technologie propriétaire d'IA musicale.
						</p>
					</div>
				</div>
				<div class="relative">
					<div class="album-container mx-auto" style="width: 400px; height: 250px;">
						<div class="album-cover">
							<div class="album-cover-closed">
								<img src="/images/covers/poppy-music-closed.png" alt="Album fermé" class="w-full h-full object-cover" />
							</div>
							<div class="album-cover-opened">
								<img src="/images/covers/poppy-music-opened.png" alt="Album ouvert avec vinyle" class="w-full h-full object-cover" />
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- PRODUCTIONS -->
	<section id="productions" class="py-32 px-6 bg-gradient-to-b from-[#0B0B0B] to-[#121212]">
		<div class="max-w-7xl mx-auto">
			<h2 class="title-artistic text-5xl md:text-6xl text-white text-center mb-4">
				Nos <span class="text-[#c76927]">Productions</span>
			</h2>
			<p class="text-artistic text-lg text-gray-400 text-center mb-8 max-w-3xl mx-auto">
				Découvrez les créations de nos producteurs. Chaque chanson raconte une histoire, 
				porte un message, exprime une émotion unique.
			</p>
			
			<!-- Tags cliquables pour filtrage -->
			<div class="flex flex-wrap justify-center gap-4 mb-20">
				<button id="filter-all" class="filter-tag active flex items-center gap-2 px-4 py-2 rounded-full border-2 border-[#c76927] bg-[#c76927] bg-opacity-20 text-white hover:bg-opacity-30 transition-all cursor-pointer">
					<span class="text-sm font-medium">Tous</span>
				</button>
				<button id="filter-amour" class="filter-tag flex items-center gap-2 px-4 py-2 rounded-full border-2 border-rose-500 border-opacity-50 hover:border-opacity-100 hover:bg-rose-500 hover:bg-opacity-20 transition-all cursor-pointer" data-filter="Amour">
					<span class="w-3 h-3 bg-rose-500 rounded-full"></span>
					<span class="text-gray-400 text-sm font-medium">Amour</span>
				</button>
				<button id="filter-club" class="filter-tag flex items-center gap-2 px-4 py-2 rounded-full border-2 border-orange-500 border-opacity-50 hover:border-opacity-100 hover:bg-orange-500 hover:bg-opacity-20 transition-all cursor-pointer" data-filter="Club">
					<span class="w-3 h-3 bg-orange-500 rounded-full"></span>
					<span class="text-gray-400 text-sm font-medium">Club</span>
				</button>
				<button id="filter-anniversaire-adulte" class="filter-tag flex items-center gap-2 px-4 py-2 rounded-full border-2 border-purple-500 border-opacity-50 hover:border-opacity-100 hover:bg-purple-500 hover:bg-opacity-20 transition-all cursor-pointer" data-filter="Anniversaire Adulte">
					<span class="w-3 h-3 bg-purple-500 rounded-full"></span>
					<span class="text-gray-400 text-sm font-medium">Anniversaire Adulte</span>
				</button>
				<button id="filter-anniversaire-enfant" class="filter-tag flex items-center gap-2 px-4 py-2 rounded-full border-2 border-pink-500 border-opacity-50 hover:border-opacity-100 hover:bg-pink-500 hover:bg-opacity-20 transition-all cursor-pointer" data-filter="Anniversaire Enfant">
					<span class="w-3 h-3 bg-pink-500 rounded-full"></span>
					<span class="text-gray-400 text-sm font-medium">Anniversaire Enfant</span>
				</button>
				<button id="filter-entreprise" class="filter-tag flex items-center gap-2 px-4 py-2 rounded-full border-2 border-blue-500 border-opacity-50 hover:border-opacity-100 hover:bg-blue-500 hover:bg-opacity-20 transition-all cursor-pointer" data-filter="Entreprise">
					<span class="w-3 h-3 bg-blue-500 rounded-full"></span>
					<span class="text-gray-400 text-sm font-medium">Entreprise</span>
				</button>
				<button id="filter-association" class="filter-tag flex items-center gap-2 px-4 py-2 rounded-full border-2 border-green-500 border-opacity-50 hover:border-opacity-100 hover:bg-green-500 hover:bg-opacity-20 transition-all cursor-pointer" data-filter="Association">
					<span class="w-3 h-3 bg-green-500 rounded-full"></span>
					<span class="text-gray-400 text-sm font-medium">Association</span>
				</button>
			</div>

			<div id="productions-grid">
				<ProductionsGrid />
			</div>
		</div>
	</section>

	<!-- SERVICES CRÉATIFS -->
	<section class="py-32 px-6">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
				<div>
					<h2 class="title-artistic text-5xl md:text-6xl text-white mb-8 leading-tight">
						Votre Projet<br/>
						<span class="text-[#c76927]">Musical</span>
					</h2>
					<div class="text-artistic text-lg text-gray-300 space-y-6 mb-12">
						<p>
							<strong>Vous devenez le producteur</strong> de votre propre chanson. Nous vous accompagnons 
							de l'idée initiale jusqu'à la diffusion sur toutes les plateformes mondiales.
						</p>
						<p>
							Que ce soit pour porter un message, célébrer un moment, ou créer votre signature sonore, 
							<strong>votre nom apparaîtra dans les crédits</strong> comme producteur de l'œuvre.
						</p>
					</div>
					
					<div class="space-y-8">
						<div class="flex items-start gap-6">
							<div class="w-12 h-12 bg-[#c76927] flex items-center justify-center text-black font-bold text-lg">01</div>
							<div>
								<h3 class="text-white font-semibold text-xl mb-2">Brief de Production</h3>
								<p class="text-gray-400">Votre message, votre style, l'émotion que vous voulez transmettre</p>
							</div>
						</div>
						<div class="flex items-start gap-6">
							<div class="w-12 h-12 bg-[#c76927] flex items-center justify-center text-black font-bold text-lg">02</div>
							<div>
								<h3 class="text-white font-semibold text-xl mb-2">Pre-Production</h3>
								<p class="text-gray-400">Exploration créative, maquettes et direction artistique</p>
							</div>
						</div>
						<div class="flex items-start gap-6">
							<div class="w-12 h-12 bg-[#c76927] flex items-center justify-center text-black font-bold text-lg">03</div>
							<div>
								<h3 class="text-white font-semibold text-xl mb-2">Production Studio</h3>
								<p class="text-gray-400">Enregistrement, composition, mix et mastering professionnel</p>
							</div>
						</div>
					</div>

					<div class="mt-12">
						<a href="/brief-new" class="bg-[#c76927] text-black px-12 py-4 text-lg font-medium tracking-wide hover:bg-[#a85520] transition-all duration-300 rounded-md inline-block text-center">
							CRÉER MA CHANSON
							<span class="block text-sm opacity-80 mt-1">199€ - Pack complet</span>
						</a>
					</div>
				</div>
				
				<div class="glass-effect p-12 rounded-lg">
					<h3 class="title-artistic text-3xl text-white mb-8">Pack Production</h3>
					<div class="space-y-6">
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Votre Brief Producteur</h4>
							<p class="text-gray-400 text-sm">Définissez votre message, votre style, l'émotion que vous voulez transmettre</p>
						</div>
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Pre-Production</h4>
							<p class="text-gray-400 text-sm">Exploration créative, maquettes et direction artistique</p>
						</div>
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Production Studio</h4>
							<p class="text-gray-400 text-sm">Enregistrement, composition, mix et mastering professionnel</p>
						</div>
						<div class="border-l-2 border-[#c76927] pl-6">
							<h4 class="text-white font-semibold mb-2">Post-Production</h4>
							<p class="text-gray-400 text-sm">Finalisation, crédits producteur et distribution mondiale</p>
						</div>
					</div>
					
					<div class="mt-8 p-4 bg-black bg-opacity-30 rounded-lg">
						<p class="text-[#c76927] font-semibold mb-1">Inclus dans votre Pack Production :</p>
						<p class="text-gray-300 text-sm">Chanson finale • Instrumental • Paroles • Crédits producteur • Distribution streaming</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CAS D'USAGE ÉLARGIS -->
	<UseCases />

	<!-- SECTION PRICING -->
	<section id="pricing" class="py-32 px-6 bg-gradient-to-b from-[#121212] to-[#0B0B0B]">
		<div class="max-w-6xl mx-auto">
			<div class="text-center mb-16">
				<h2 class="title-artistic text-5xl md:text-6xl text-white mb-6">
					Combien ça <span class="text-[#c76927]">coûte ?</span>
				</h2>
				<p class="text-xl text-gray-300 max-w-3xl mx-auto">
					Un prix unique, transparent, pour une production musicale complète de qualité professionnelle
				</p>
			</div>

			<div class="max-w-4xl mx-auto">
				<!-- PACK PRINCIPAL -->
				<div class="bg-gradient-to-br from-orange-100 via-orange-50 to-amber-50 rounded-3xl p-8 md:p-12 border border-orange-200 shadow-2xl">
					<div class="text-center mb-12">
						<h3 class="text-gray-800 text-2xl font-bold mb-4">Pack Production Complète</h3>
						<div class="text-gray-900 text-6xl md:text-7xl font-bold mb-4">199€</div>
						<p class="text-gray-600 text-lg">TTC - Paiement unique</p>
					</div>

					<!-- TABLEAU ÉLÉGANT DES PRESTATIONS -->
					<div class="bg-white bg-opacity-95 rounded-2xl p-8 mb-12 border border-orange-200 shadow-inner">
						<div class="space-y-6">
							<!-- Création -->
							<div class="flex items-center gap-6 pb-4 border-b border-gray-200">
								<div class="w-12 h-12 bg-gradient-to-br from-[#c76927] to-[#a85520] rounded-xl flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
									</svg>
								</div>
								<div class="flex-1">
									<h4 class="text-gray-800 font-bold text-lg mb-2">Création Artistique</h4>
									<div class="flex flex-wrap gap-x-8 gap-y-1 text-gray-600 text-sm">
										<span>Composition sur-mesure</span>
										<span>Paroles personnalisées</span>
										<span>Arrangement musical</span>
										<span>IA créative assistée</span>
									</div>
								</div>
							</div>

							<!-- Production -->
							<div class="flex items-center gap-6 pb-4 border-b border-gray-200">
								<div class="w-12 h-12 bg-gradient-to-br from-[#c76927] to-[#a85520] rounded-xl flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M9.383 3.076A1 1 0 0110 4v12a1 1 0 01-1.707.707L4.586 13H2a1 1 0 01-1-1V8a1 1 0 011-1h2.586l3.707-3.707a1 1 0 011.09-.217z"/>
									</svg>
								</div>
								<div class="flex-1">
									<h4 class="text-gray-800 font-bold text-lg mb-2">Production Studio</h4>
									<div class="flex flex-wrap gap-x-8 gap-y-1 text-gray-600 text-sm">
										<span>Enregistrement professionnel</span>
										<span>Mix & mastering</span>
										<span>Qualité streaming</span>
										<span>Livraison MP3 HD</span>
									</div>
								</div>
							</div>

							<!-- Visuels -->
							<div class="flex items-center gap-6 pb-4 border-b border-gray-200">
								<div class="w-12 h-12 bg-gradient-to-br from-[#c76927] to-[#a85520] rounded-xl flex items-center justify-center flex-shrink-0">
									<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z"/>
									</svg>
								</div>
								<div class="flex-1">
									<h4 class="text-gray-800 font-bold text-lg mb-2">Identité Visuelle</h4>
									<div class="flex flex-wrap gap-x-8 gap-y-1 text-gray-600 text-sm">
										<span>Cover professionnelle</span>
										<span>Artwork personnalisé</span>
										<span>Formats multiples</span>
										<span>Design sur-mesure</span>
									</div>
								</div>
							</div>

