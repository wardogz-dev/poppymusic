---
import '../styles/global.css';

const title = "Brief Envoyé - Poppy Music";
const description = "Votre brief créatif a été envoyé avec succès. Nous vous contacterons bientôt.";
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/icon-2025.svg" type="image/svg+xml" />
		<meta name="robots" content="noindex, nofollow" />

		<!-- Google Tag Manager -->
		<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
		j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
		'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
		})(window,document,'script','dataLayer','GTM-NGZ6SCTP');</script>
		<!-- End Google Tag Manager -->
	</head>
	
	<body class="bg-[#0B0B0B] text-gray-100 font-['Inter'] antialiased min-h-screen flex items-center justify-center">
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NGZ6SCTP"
		height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<!-- End Google Tag Manager (noscript) -->
		<div class="max-w-2xl w-full mx-auto px-6 text-center">
			<!-- SUCCÈS -->
			<div class="mb-8">
				<div class="w-20 h-20 bg-green-500 bg-opacity-20 rounded-full flex items-center justify-center mx-auto mb-6">
					<span class="text-green-400 text-4xl">✅</span>
				</div>
				<h1 class="title-artistic text-4xl md:text-5xl text-white mb-4">
					Brief <span class="text-[#c76927]">Envoyé</span> !
				</h1>
				<p class="text-xl text-gray-300 leading-relaxed">
					Votre demande créative a été enregistrée avec succès. 
					Nous allons l'étudier et vous contacter dans les 24h.
				</p>
			</div>

			<!-- PROCHAINES ÉTAPES -->
			<div class="bg-gray-900 bg-opacity-50 rounded-lg p-8 mb-8">
				<h2 class="text-2xl font-bold text-[#c76927] mb-6">Prochaines étapes</h2>
				
				<div class="space-y-4 text-left">
					<div class="flex items-start space-x-4">
						<div class="w-8 h-8 bg-[#c76927] text-black rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">1</div>
						<div>
							<h3 class="font-semibold text-white">Analyse de votre brief</h3>
							<p class="text-gray-400 text-sm">Notre équipe étudie votre demande et prépare une proposition personnalisée.</p>
						</div>
					</div>
					
					<div class="flex items-start space-x-4">
						<div class="w-8 h-8 bg-[#c76927] text-black rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">2</div>
						<div>
							<h3 class="font-semibold text-white">Contact et validation</h3>
							<p class="text-gray-400 text-sm">Nous vous contacterons pour affiner les détails et valider le projet.</p>
						</div>
					</div>
					
					<div class="flex items-start space-x-4">
						<div class="w-8 h-8 bg-[#c76927] text-black rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0">3</div>
						<div>
							<h3 class="font-semibold text-white">Paiement et production</h3>
							<p class="text-gray-400 text-sm">Une fois le paiement effectué, nous commençons la création de votre chanson.</p>
						</div>
					</div>
				</div>
			</div>

			<!-- INFORMATIONS DE CONTACT -->
			<div class="text-center">
				<p class="text-gray-400 mb-4">Une question ? Contactez-nous :</p>
				<a href="mailto:hello@poppymusic.fr" class="text-[#c76927] hover:text-white transition-colors font-medium">
					hello@poppymusic.fr
				</a>
			</div>

			<!-- RETOUR ACCUEIL -->
			<div class="mt-8">
				<a href="/" class="inline-block border border-[#c76927] text-[#c76927] px-8 py-3 font-medium tracking-wide hover:bg-[#c76927] hover:text-black transition-all duration-300 rounded-md">
					RETOUR À L'ACCUEIL
				</a>
			</div>
		</div>

		<script>
			// @ts-nocheck
			(async () => {
				// Initialiser dataLayer pour GTM
				window.dataLayer = window.dataLayer || [];
				
				// Lire les paramètres URL
				const urlParams = new URLSearchParams(window.location.search);
				const briefId = urlParams.get('briefId');
				const sessionId = urlParams.get('session_id'); // Stripe session ID
				
				console.log('🎯 Page confirmation - Brief ID:', briefId, 'Session ID:', sessionId);
				
				// Si on a un session_id, vérifier le paiement auprès de Stripe
				if (sessionId) {
					try {
						console.log('🔍 Vérification du paiement Stripe...');
						
						// Vérifier le statut du paiement
						const response = await fetch(`/api/stripe/payment-status?session_id=${sessionId}`);
						const paymentData = await response.json();
						
						console.log('💳 Stripe payment-status:', paymentData);
						
						if (paymentData.success && paymentData.paid) {
							// Anti-doublon avec localStorage
							const purchaseKey = `purchased_${sessionId}`;
							if (localStorage.getItem(purchaseKey)) {
								console.log('⚠️ Purchase déjà tracké, éviter doublon');
								return;
							}
							localStorage.setItem(purchaseKey, '1');
							
							// Préparer les données de conversion
							const purchaseData = {
								event: 'purchase',
								transaction_id: sessionId,
								value: (paymentData.paymentDetails.amount_total || 16000) / 100, // Conversion cents -> euros (160€)
								currency: paymentData.paymentDetails.currency || 'EUR',
								items: [{
									item_id: 'chanson-personnalisee',
									item_name: 'Chanson Personnalisée Poppy Music',
									item_category: 'Music Production',
									item_variant: 'Standard',
									price: (paymentData.paymentDetails.amount_total || 16000) / 100,
									quantity: 1
								}],
								customer_email: paymentData.paymentDetails.customer_email || '',
								payment_method: 'stripe'
							};
							
							// Push vers GTM
							console.log('🎯 GTM Event: purchase', purchaseData);
							window.dataLayer.push(purchaseData);
							
							// Événement de confirmation de page
							window.dataLayer.push({
								event: 'conversion_confirmation',
								event_category: 'Payment',
								event_label: 'Payment Confirmed',
								value: purchaseData.value,
								transaction_id: sessionId
							});
							
							console.log('✅ Événements purchase envoyés vers GTM');
							
						} else {
							console.log('❌ Paiement non confirmé ou échec:', paymentData);
						}
						
					} catch (error) {
						console.error('❌ Erreur vérification paiement:', error);
					}
				} else if (briefId) {
					// Fallback pour les anciens liens sans session_id
					console.log('📝 Brief ID trouvé sans session_id, conversion basique');
					
					const basicPurchaseData = {
						event: 'purchase',
						transaction_id: briefId,
						value: 160,
						currency: 'EUR',
						items: [{
							item_id: 'chanson-personnalisee',
							item_name: 'Chanson Personnalisée Poppy Music',
							item_category: 'Music Production',
							price: 160,
							quantity: 1
						}]
					};
					
					console.log('🎯 GTM Event: purchase (fallback)', basicPurchaseData);
					window.dataLayer.push(basicPurchaseData);
				}
			})();
		</script>

		<!-- FOOTER DISCRET -->
		<footer class="border-t border-gray-800 py-6 mt-12">
			<div class="max-w-4xl mx-auto px-6 text-center">
				<p class="text-gray-500 text-xs">
					© 2025 Wardogz - Poppy Music. Tous droits réservés. 
					<a href="/cgv" class="text-gray-400 hover:text-[#c76927] transition-colors ml-2">CGV</a>
				</p>
			</div>
		</footer>
	</body>
</html>
